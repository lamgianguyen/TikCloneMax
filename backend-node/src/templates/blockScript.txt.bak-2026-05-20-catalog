<script>
/* ─────────────────────────────────────────────────────────────────────
   STANDALONE PostHog stub + new-navigation flag installer.
   Runs in its OWN IIFE before the main blockScript IIFE so that an error
   anywhere in the main IIFE (1500+ lines, many DOM observers, network
   patches, auth flows) cannot prevent the feature-flag stub from being
   installed. Without this, the bundle's posthog.isFeatureEnabled(
   'new-navigation') returns undefined → falsy → bundle renders the
   legacy text-sidebar layout. Symptom: pressing Ctrl+R sometimes drops
   back to the legacy layout because some error path in the main IIFE
   short-circuited before reaching the posthog block at line ~1132.
   Keeping this stub minimal and self-contained eliminates that race.
   ───────────────────────────────────────────────────────────────────── */
(function tfEarlyPosthogStub(){
  try {
    var noop = function(){};
    var stub = window.posthog || {};
    if (stub.__loaded) return;
    var flags = { 'new-navigation': true, 'new-navigation-design': true };
    stub.__loaded = true;
    stub._i = Array.isArray(stub._i) ? stub._i : [];
    stub.people = stub.people || {};
    stub.isFeatureEnabled = function(f){ return !!flags[f]; };
    stub.getFeatureFlag = function(f){ return flags.hasOwnProperty(f) ? flags[f] : null; };
    stub.getFeatureFlagPayload = function(){ return null; };
    stub.onFeatureFlags = function(cb){
      try { if (typeof cb === 'function') setTimeout(function(){ cb(Object.keys(flags), flags); }, 0); } catch(e){}
      return noop;
    };
    // Methods bundle calls during boot — all no-ops, just must not throw.
    ['init','capture','identify','reset','alias','opt_in_capturing','opt_out_capturing',
     'register','register_once','unregister','setPersonProperties','setPersonPropertiesForFlags',
     'group','setGroupPropertiesForFlags','reloadFeatureFlags','startSessionRecording',
     'stopSessionRecording','startSurveys','stopSurveys','debug','setConfig','set_config']
      .forEach(function(m){ if (typeof stub[m] !== 'function') stub[m] = noop; });
    stub.on = function(){ return noop; };
    stub.canRenderSurvey = function(){ return false; };
    stub.canRenderSurveyAsync = function(){ return Promise.resolve(false); };
    stub.getEarlyAccessFeatures = function(){ return []; };
    stub.getSurveys = function(){ return []; };
    stub.getActiveMatchingSurveys = function(){ return []; };
    stub.get_distinct_id = function(){ return ''; };
    stub.get_session_id = function(){ return ''; };
    stub.has_opted_in_capturing = function(){ return false; };
    stub.has_opted_out_capturing = function(){ return false; };
    stub.is_capturing = function(){ return false; };
    window.posthog = stub;
  } catch (e) { try { console.warn('[tfEarlyPosthogStub] failed:', e && e.message); } catch(_){} }

  // Set body[data-new-navigation-design] as soon as body exists so the
  // bundle's boot-time check sees the new-design opt-in even if Vue
  // navigation mounting is delayed or fails.
  function tfSetNavAttr() {
    try {
      if (document.body && !document.body.hasAttribute('data-new-navigation-design')) {
        document.body.setAttribute('data-new-navigation-design', 'true');
      }
    } catch (e) {}
  }
  tfSetNavAttr();
  if (!document.body) {
    try {
      var bodyObs = new MutationObserver(function(){
        if (document.body) { tfSetNavAttr(); try { bodyObs.disconnect(); } catch(_){} }
      });
      bodyObs.observe(document.documentElement, { childList: true });
    } catch (e) {}
    try { document.addEventListener('DOMContentLoaded', tfSetNavAttr, { once: true }); } catch(_){}
  }
})();

/* ─────────────────────────────────────────────────────────────────────
   STANDALONE i18n patch installer.
   The new bundle (≥3.9MB combo/app.js) introduced 57 translation keys
   (`tts.voice_picker.*`, `tts.credits_topup.*`, `tts.daily_limit.*`, ...)
   that are baked into `downloads/vi` only. When user lands on the
   default English `downloads/index.html` the bundle's t() lookups
   return undefined → modals render the raw key (e.g. the voice-picker
   tabs show `tts.voice_picker.ai_tab` instead of "AI"). We can't easily
   patch the English HTML because the bundle reads its locale via
   `window.tfPageloadData.appConfig.localization[lang]` — that object is
   assembled inline in HTML before our injection runs.
   Strategy: poll briefly for `window.tfPageloadData` and merge the missing
   keys into every locale we know about. This keeps the modal labels
   readable regardless of which HTML variant was served. Run early
   so the merge wins the race against the bundle's first t() call.
   Patch JSON comes from `templates/i18n-patch.json`, interpolated by
   `index-html.js` via the {{i18nPatchJson}} placeholder.
   ───────────────────────────────────────────────────────────────────── */
/* ─────────────────────────────────────────────────────────────────────
   STANDALONE i18n pre-bake interceptor.
   Bundle copies `window.tfPageloadData.localization.<lang>` into its own
   vue-i18n / Composition API store AT INIT (synchronously during the first
   render pass). Any polling-based patch that runs AFTER that copy is too
   late — bundle's t() reads from the internal copy, not the live object.
   Fix: install a property interceptor on `window.tfPageloadData` BEFORE the
   inline body script that performs `window.tfPageloadData = {...}`. Our
   setter mutates the value just-assigned to add the missing keys, THEN
   stores it. By the time bundle's app.js script runs, the localization
   object already has our keys merged in — bundle's snapshot includes them.
   This works because: (1) head-injection scripts execute before body-inline
   scripts, (2) defineProperty's setter fires synchronously on assignment,
   (3) bundle reads tfPageloadData synchronously after that assignment.
   ───────────────────────────────────────────────────────────────────── */
(function tfI18nPreBake(){
  var patch = {{i18nPatchJson}};
  if (!patch || typeof patch !== 'object' || !Object.keys(patch).length) return;
  var _stored;
  function mergeInto(data){
    if (!data || !data.localization || typeof data.localization !== 'object') return;
    var locs = Object.keys(data.localization);
    var inserted = 0;
    locs.forEach(function(lang){
      var bucket = data.localization[lang];
      if (!bucket || typeof bucket !== 'object') return;
      for (var k in patch) {
        if (Object.prototype.hasOwnProperty.call(patch, k) && !(k in bucket)) {
          bucket[k] = patch[k];
          inserted++;
        }
      }
    });
    try { console.log('[TF-i18n-prebake] intercepted assign — merged', inserted, 'into locales', locs); } catch(_){}
  }
  try {
    // If tfPageloadData already exists (e.g. on bundle hot-reload where the
    // setter trap may have been wiped), patch the live object and skip the
    // defineProperty install (can't redefine without configurable:true on
    // existing prop — and avoiding a throw matters more than installing the
    // trap a second time).
    if (Object.getOwnPropertyDescriptor(window, 'tfPageloadData')) {
      mergeInto(window.tfPageloadData);
      return;
    }
    Object.defineProperty(window, 'tfPageloadData', {
      configurable: true,
      enumerable: true,
      get: function(){ return _stored; },
      set: function(v){ mergeInto(v); _stored = v; }
    });
  } catch(e){
    try { console.warn('[TF-i18n-prebake] install failed:', e && e.message); } catch(_){}
  }
})();

(function tfI18nPatch(){
  var patch = {{i18nPatchJson}};
  if (!patch || typeof patch !== 'object' || !Object.keys(patch).length) return;
  function apply(){
    try {
      var pld = window.tfPageloadData;
      // Bundle ≥3.9MB moved localization OUT of appConfig: it now lives at
      // `tfPageloadData.localization.<lang>` (top-level), not inside appConfig.
      // The old nested path is gone — patching it does nothing.
      var loc = pld && pld.localization;
      if (!loc) return false;
      // Only patch locales that already have data; don't create empty buckets
      // (bundle's t() looks up by current locale only, so creating empty `vi`
      // on the English page would hide keys behind that empty bucket if the
      // bundle were to switch locale at runtime).
      var langs = Object.keys(loc);
      var merged = 0;
      langs.forEach(function(lang){
        var bucket = loc[lang];
        if (!bucket || typeof bucket !== 'object') return;
        for (var k in patch) {
          if (Object.prototype.hasOwnProperty.call(patch, k) && !(k in bucket)) {
            bucket[k] = patch[k];
            merged++;
          }
        }
      });
      try { console.log('[TF-i18n-patch] merged', merged, 'key-insertions into locales', langs); } catch(_){}
      return true;
    } catch(e){
      try { console.warn('[TF-i18n-patch] apply failed:', e && e.message); } catch(_){}
      return false;
    }
  }
  if (apply()) return;
  // tfPageloadData is set inline in the document b-o-d-y AFTER our head
  // injection runs. Note: never write the literal lower-case b o d y opening
  // tag here because the surrounding HTML build does a /body-tag/i replace and
  // would otherwise inject the entire b o d y template INSIDE this comment,
  // breaking the script tag.
  // Poll up to 5s with a tight 30ms interval so the merge lands before any
  // Vue component reads its t() bindings on first render.
  var t0 = Date.now();
  var iv = setInterval(function(){
    if (apply() || Date.now() - t0 > 5000) {
      try { clearInterval(iv); } catch(_){}
    }
  }, 30);
})();

(function(){
  // While the bundle's #splashScreen ("Getting things ready for you...")
  // is visible, set body.tf-splash-active so CSS hides the partially
  // mounted sidebar / topbar underneath. As soon as the bundle hides
  // (display:none / visibility:hidden) or removes #splashScreen, drop
  // the class so the real UI becomes visible.
  function tfIsSplashVisible(el) {
    if (!el || !el.isConnected) return false;
    var st;
    try { st = window.getComputedStyle(el); } catch (e) { return false; }
    if (!st) return false;
    if (st.display === 'none') return false;
    if (st.visibility === 'hidden' || st.visibility === 'collapse') return false;
    if (parseFloat(st.opacity || '1') === 0) return false;
    return true;
  }
  function tfApplySplashClass() {
    try {
      var el = document.getElementById('splashScreen');
      var body = document.body;
      var html = document.documentElement;
      if (!body || !html) return;
      if (tfIsSplashVisible(el)) {
        body.classList.add('tf-splash-active');
        html.classList.add('tf-splash-active');
      } else {
        body.classList.remove('tf-splash-active');
        html.classList.remove('tf-splash-active');
      }
    } catch (_) {}
  }
  function tfWatchSplash() {
    try {
      tfApplySplashClass();
      // Narrow observer: only watch #splashScreen itself + its parent for
      // child removal. Avoid documentElement subtree which fires on every
      // bundle DOM mutation and blocks the script-load callbacks.
      function attachSplashObs() {
        var el = document.getElementById('splashScreen');
        if (!el) return;
        try {
          var attrObs = new MutationObserver(function() { tfApplySplashClass(); });
          attrObs.observe(el, { attributes: true, attributeFilter: ['style', 'class', 'hidden'] });
          if (el.parentNode) {
            var rmObs = new MutationObserver(function(muts) {
              for (var i = 0; i < muts.length; i++) {
                if (muts[i].removedNodes && muts[i].removedNodes.length) {
                  tfApplySplashClass();
                  return;
                }
              }
            });
            rmObs.observe(el.parentNode, { childList: true });
          }
        } catch (_) {}
      }
      if (document.getElementById('splashScreen')) {
        attachSplashObs();
      } else {
        // Splash element may not exist yet when this script runs in the head.
        // Poll for ~3s until it appears, then attach.
        var tries = 0;
        var poll = setInterval(function() {
          if (document.getElementById('splashScreen')) {
            clearInterval(poll);
            tfApplySplashClass();
            attachSplashObs();
          } else if (++tries > 30) {
            clearInterval(poll);
          }
        }, 100);
      }
    } catch (_) {}
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', tfWatchSplash, { once: true });
  } else {
    tfWatchSplash();
  }

  // One-time cleanup: purge the legacy hardcoded dev token so users
  // who previously had auto-login fall back to the real login flow.
  try {
    var legacy = 'tf_local_dev_token_2024';
    var existing = localStorage.getItem('setting_loginaccesstoken');
    if (existing === legacy) {
      localStorage.removeItem('setting_loginaccesstoken');
      localStorage.removeItem('setting_loginaccesstokenprovider');
      localStorage.removeItem('setting_pendinglogin');
      localStorage.removeItem('setting_channelid');
      localStorage.removeItem('setting_channelname');
      localStorage.removeItem('setting_ispro');
      document.cookie = 'tf_login_token=; path=/; max-age=0';
      document.cookie = 'tf_channelid=; path=/; max-age=0';
      document.cookie = 'tf_channelname=; path=/; max-age=0';
      document.cookie = 'tf_ispro=; path=/; max-age=0';
    }
  } catch(e) {}

  // Hide the top-of-app "Connection failed" / "Error while connecting" banner
  // that the obfuscated bundle renders whenever a TikTok connect attempt
  // fails. The styles target the bundle's notification bars (colors `bg-red*`,
  // role=alert, etc.) and the observer below force-removes any banner whose
  // text matches our denylist.
  //
  // We persist the same error in the notification bell instead, so the user
  // can review it on demand without a flickering full-width red strip.
  // Note: previously had a `suppressBridgeBanner` observer here that hid
  // every connection-error banner (and a `data-tf-hide-account` CSS rule).
  // Removed to restore the bundle's native popup behaviour — when a
  // TikTok connect attempt fails the user now sees the standard
  // "Connection Failed" dialog like the original Tikfinity. Only keep
  // the dropdown-account-row hide rule, since logout still routes
  // through electron's external Serial Key flow.
  (function bridgeBannerStyles(){
    var style = document.createElement('style');
    style.textContent = '[data-tf-hide-account="1"] { display:none !important; }';
    (document.head || document.documentElement).appendChild(style);
  })();

  // Bundle natively shows its own "Connection Failed" modal on connectFailed,
  // which duplicates our centered popup (the one with "Login TikTok" button).
  // Watch for the bundle's modal and hide it. Match by signature text so we
  // don't accidentally hide legit modals.
  // Bundle's main app Socket.IO client uses default reconnect config
  // (1s initial, 5s max) which hammers the backend after a restart.
  // Patch `window.io` once available so any `new io(...)` from the bundle
  // inherits our jittered exponential backoff. Idempotent — bundle's
  // own connect config wins if it sets the same keys explicitly. We only
  // wrap when the value is the CALLABLE io factory (typeof === 'function');
  // socketioclient.js later reassigns `window.io` to a socket INSTANCE,
  // which we leave untouched.
  (function tfPatchIODefaults(){
    var DEFAULTS = {
      reconnection: true,
      reconnectionAttempts: Infinity,
      reconnectionDelay: 2000,
      reconnectionDelayMax: 30000,
      randomizationFactor: 0.5,
      timeout: 10000,
    };
    function wrap(originalIo) {
      if (typeof originalIo !== 'function' || originalIo.__tfPatched) return originalIo;
      var wrapped = function() {
        var args = Array.prototype.slice.call(arguments);
        var lastIdx = args.length - 1;
        if (args.length === 0) {
          args.push(Object.assign({}, DEFAULTS));
        } else if (typeof args[lastIdx] === 'object' && args[lastIdx] !== null && !Array.isArray(args[lastIdx])) {
          args[lastIdx] = Object.assign({}, DEFAULTS, args[lastIdx]);
        } else {
          args.push(Object.assign({}, DEFAULTS));
        }
        // Allow both `io(...)` and `new io(...)` call styles.
        if (this instanceof wrapped) {
          return new (Function.prototype.bind.apply(originalIo, [null].concat(args)))();
        }
        return originalIo.apply(this, args);
      };
      Object.keys(originalIo).forEach(function(k) {
        try { wrapped[k] = originalIo[k]; } catch (_) {}
      });
      wrapped.prototype = originalIo.prototype;
      wrapped.__tfPatched = true;
      wrapped.__tfOriginal = originalIo;
      return wrapped;
    }
    var current = null;
    Object.defineProperty(window, 'io', {
      configurable: true,
      get: function() { return current; },
      set: function(v) {
        // Only wrap the FACTORY function (set once by socket.io.min.js).
        // Subsequent assignments (socket instances from new io(...)) pass
        // through untouched.
        current = typeof v === 'function' ? wrap(v) : v;
      }
    });
  })();

  // (SSR sub-sidebar rescue removed — was lifting the wrong <nav> element.
  // The actual Setup sub-sidebar isn't a <nav>; it's a Vue-rendered DX
  // menu component. Investigating proper fix in a follow-up.)
  // Remove any stale rescued sidebar from prior page loads.
  (function tfSSRCleanup(){
    var stale = document.getElementById('tf-rescued-subsidebar');
    if (stale) stale.remove();
  })();

  // Diagnostic: log every speechSynthesis.speak() invocation so we see if
  // bundle's TTS module fires (even if it doesn't log to its own UI panel).
  (function tfTTSSpeakLogger(){
    if (!window.speechSynthesis) return;
    var orig = speechSynthesis.speak.bind(speechSynthesis);
    var count = 0;
    speechSynthesis.speak = function(utt) {
      count++;
      var text = utt && utt.text ? utt.text.slice(0, 100) : '<no text>';
      console.log('[TF-TTS-Speak #' + count + '] ' + text);
      window.__tfTTSCount = function() { return count; };
      return orig(utt);
    };
    console.log('[TF-TTS-Speak] speak() interceptor installed');
  })();

  // Diagnostic socket .on() subscription logger — wraps Socket.prototype.on
  // so we see every event the BUNDLE subscribes to. Lets us discover the
  // exact event name bundle's TTS handler listens for (instead of guessing
  // 'chat' vs 'newChatMessage' vs 'tiktokChat'). Records the call stack
  // line so we know which Vue component subscribed.
  (function tfSocketOnLogger(){
    var attached = false;
    var subs = Object.create(null);
    var poll = setInterval(function() {
      if (attached) { clearInterval(poll); return; }
      var io = window.io;
      if (!io || !io.on || !io.constructor || !io.constructor.prototype) return;
      try {
        var proto = Object.getPrototypeOf(io);
        var origOn = proto.on;
        if (typeof origOn !== 'function' || origOn.__tfPatched) return;
        proto.on = function(ev, fn) {
          if (typeof ev === 'string') {
            subs[ev] = (subs[ev] || 0) + 1;
            console.log('[TF-SocketSub] io.on("' + ev + '") subscribed (total subscribers for this event: ' + subs[ev] + ')');
          }
          return origOn.apply(this, arguments);
        };
        proto.on.__tfPatched = true;
        attached = true;
        clearInterval(poll);
        console.log('[TF-SocketSub] subscription logger attached — watching io.on() calls');
        window.__tfSocketSubs = function() { console.table(subs); return subs; };
      } catch (e) {}
    }, 200);
    setTimeout(function() { if (!attached) clearInterval(poll); }, 30000);
  })();

  // Diagnostic socket event logger — patches Socket.IO Manager so we see
  // EVERY incoming event with payload. Lets user verify which events reach
  // the bundle's main page socket. Counts per event name exposed via
  // window.__tfSocketStats().
  (function tfSocketEventLogger(){
    // PREVIOUS IMPLEMENTATION BUG: this used to call window.io.onAny(...) where
    // window.io is the io.connect factory function, not a socket instance. The
    // factory has no event system, so onAny silently attached nothing — every
    // diagnostic relying on tfSocketStats was useless. Fix: wrap io() factory
    // so every Socket the bundle creates is captured + onAny-hooked.
    if (window.__tfIoFactoryHooked) return;
    var stats = Object.create(null);
    var sockets = [];
    function captureSocket(sock, label) {
      if (!sock || typeof sock.onAny !== 'function') return;
      if (sock.__tfHooked) return;
      sock.__tfHooked = true;
      sockets.push({ label: label, socket: sock });
      sock.onAny(function(event, payload) {
        stats[event] = (stats[event] || 0) + 1;
        var preview = '';
        try {
          if (typeof payload === 'object' && payload) {
            var keys = Object.keys(payload).slice(0, 5);
            preview = '{' + keys.map(function(k){
              var v = payload[k];
              if (typeof v === 'string') return k + '="' + v.slice(0, 40) + '"';
              if (typeof v === 'number' || typeof v === 'boolean') return k + '=' + v;
              if (Array.isArray(v)) return k + '[' + v.length + ']';
              return k + ':' + typeof v;
            }).join(', ') + '}';
          } else { preview = String(payload).slice(0, 60); }
        } catch (_) {}
        console.log('[TF-SocketEvt ' + label + ' #' + stats[event] + '] ' + event + ' → ' + preview);
      });
      console.log('[TF-SocketEvt] socket captured: ' + label + ' id=' + sock.id + ' nsp=' + sock.nsp);
    }

    function hookFactory() {
      if (typeof window.io !== 'function' || window.io.__tfHooked) return false;
      var origIo = window.io;
      var wrapped = function() {
        var sock = origIo.apply(this, arguments);
        try { captureSocket(sock, 'io(' + (arguments[0] || '/') + ')'); } catch(_){}
        return sock;
      };
      Object.keys(origIo).forEach(function(k){ try { wrapped[k] = origIo[k]; } catch(_){} });
      wrapped.__tfHooked = true;
      try { window.io = wrapped; } catch(_) {}
      window.__tfIoFactoryHooked = true;
      console.log('[TF-SocketEvt] io() factory hooked');
      return true;
    }

    // Try to hook factory immediately; poll if io isn't loaded yet.
    if (!hookFactory()) {
      var poll = setInterval(function() {
        if (hookFactory()) clearInterval(poll);
      }, 200);
      setTimeout(function() { clearInterval(poll); }, 30000);
    }

    // Retroactively capture sockets that already exist (created before our
    // hook). Walk window props to find them.
    function rescanRetro() {
      try {
        Object.keys(window).forEach(function(k){
          try {
            var v = window[k];
            if (v && typeof v === 'object' && typeof v.onAny === 'function' && 'connected' in v && v.nsp) {
              captureSocket(v, 'window.' + k);
            }
          } catch(_){}
        });
      } catch(_){}
    }
    rescanRetro();
    setTimeout(rescanRetro, 1000);
    setTimeout(rescanRetro, 3000);
    setTimeout(rescanRetro, 8000);

    window.__tfSocketStats = function() {
      console.table(stats);
      return { stats: stats, capturedSockets: sockets.map(function(s){ return { label: s.label, id: s.socket.id, connected: s.socket.connected, nsp: s.socket.nsp }; }) };
    };
  })();

  // Dev-only auto-reload: backend's `fs.watch` on templates/ broadcasts
  // `tf-dev-reload` over Socket.IO whenever a .txt template is saved.
  //
  // PRIOR BUG: this attached `io.on('tf-dev-reload', ...)` to `window.io`
  // — the io.connect FACTORY function — which has no event system. The
  // listener never fired, so every template edit required a manual Ctrl+R.
  // Same root cause as the fix in tfSocketEventLogger above.
  //
  // FIX: attach to every actual Socket instance we can find — scan window
  // for socket-shaped objects (notificationSocket etc.) and also wrap io()
  // factory so any socket the bundle creates later inherits the listener.
  (function tfDevAutoReload(){
    var triggered = false;
    function doReload() {
      if (triggered) return;
      triggered = true;
      // Throttle: if we reloaded within the last 5s already, ignore this
      // broadcast. Prevents a reload storm when several template files are
      // saved in quick succession (each save → debounced broadcast → reload).
      // Without this, the kill-switch in reloadGuard cannot stop the loop
      // because dev auto-reload historically bypassed Location.prototype
      // and went through __tfOrigReload directly.
      try {
        // Throttle is in-memory (per page load) — does NOT persist across
        // reloads. After a reload completes, the in-memory `__tfReloadedAt`
        // gets re-initialised, so the next legitimate broadcast (e.g. user
        // saves another template right after) is honoured immediately.
        // This avoids the "save edits → no auto-reload → must Ctrl+R" trap.
        var lastTs = window.__tfReloadedAt || 0;
        if (lastTs && (Date.now() - lastTs) < 2000) {
          console.warn('[TF-DEV] reload broadcast ignored (last was ' + (Date.now() - lastTs) + 'ms ago)');
          triggered = false;
          return;
        }
        window.__tfReloadedAt = Date.now();
      } catch (_) {}
      console.log('[TF-DEV] template changed — auto-reload');
      // Go through the regular location.reload() so reloadGuard's
      // sliding-window kill-switch can still freeze the page if a real
      // reload loop somehow develops. Bypassing reloadGuard via
      // __tfOrigReload (previous behaviour) made dev auto-reload
      // unstoppable.
      try { location.reload(); }
      catch (e) { if (typeof window.__tfOrigReload === 'function') window.__tfOrigReload(); }
    }

    function attach(sock, label) {
      if (!sock || typeof sock.on !== 'function' || sock.__tfDevReloadAttached) return;
      sock.__tfDevReloadAttached = true;
      try {
        sock.on('tf-dev-reload', doReload);
        console.log('[TF-DEV] auto-reload listener attached to', label);
      } catch (e) {}
    }

    function rescan() {
      try {
        Object.keys(window).forEach(function(k){
          try {
            var v = window[k];
