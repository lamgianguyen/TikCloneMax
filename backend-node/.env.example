# ── TikCloneMax backend — env vars (config.js đọc) ───────────────────────────
# Set khi BUILD / dựng server. Backend không tự load .env (đọc process.env trực
# tiếp) — set ở env của tiến trình launch HOẶC bake lúc build. File này = tham chiếu.

# ★ BẮT BUỘC cho RELEASE KHÁCH HÀNG ★
# URL license server PRODUCTION (nơi validate Serial Key). MẶC ĐỊNH http://127.0.0.1:5194
# CHỈ đúng khi license server chạy CÙNG MÁY — máy khách KHÔNG chạy nó → khách KHÔNG
# login được. PHẢI set thành URL server license thật của bạn (vd https://license.your-domain.com).
TIKFINITY_AUTH_HOST=http://127.0.0.1:5194

# ── Optional (đều có default/auto an toàn) ───────────────────────────────────
# JWT secret. KHÔNG set → packaged build TỰ tạo + persist random secret (an toàn);
# dev (non-packaged) dùng dev-fallback (cảnh báo log). Set nếu muốn cố định cross-machine.
# TIKMAX_JWT_SECRET=

# Eulerstream paid signing key (TikTok WS sign). Rỗng → free tier (ws hơi chập đầu
# ~4-5 phút tới khi user TikTok sign-in xong). Set để ws ổn định ngay.
# SIGN_API_KEY=

# Port backend (Electron tự set khi spawn). Mặc định 5285.
# PORT=5285

# Data dir (DB + cache). Electron set = %APPDATA%/tikfinity-desktop. Override nếu cần.
# TIKMAX_DATA_DIR=

# Log level: info | warn | error | debug. Mặc định info.
# LOG_LEVEL=info
