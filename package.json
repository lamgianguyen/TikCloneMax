{
  "name": "tikfinity-clone",
  "version": "1.0.0",
  "description": "TikFinity desktop clone. Node backend + Electron shell + bundled frontend.",
  "private": true,
  "scripts": {
    "web": "npm --prefix backend-node start",
    "web:dev": "npm --prefix backend-node run dev",
    "desktop": "npm --prefix electron start",
    "desktop:build": "npm --prefix electron run build",
    "install:all": "npm --prefix backend-node install && npm --prefix electron install",
    "build:installer": "npm --prefix electron run build:installer",
    "reverse": "node scripts/decompile/run-all.js",
    "reverse:no-decompile": "node scripts/decompile/run-all.js --skip-decompile",
    "qa": "node qa/run-all.js",
    "qa:mutating": "node qa/run-all.js --mutating",
    "qa:json": "node qa/run-all.js --json"
  },
  "author": "",
  "license": "ISC"
}
