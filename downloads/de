creens">\n <h3 class="blueheading noTopMarginHeader" data-str="actionsandevents_screens_head"></h3>\n <div data-str="actionsandevents_screens_desc"></div>\n\n <br>\n <div id="onPageScreenContainer"></div> \n</div>\n\n\n\n<div class="greyBackgroundSection greyBackgroundSectionDynamicWidth" id="actionsandevents-timer">\n <h3 class="blueheading noTopMarginHeader" data-str="actionsandevents_timerevents_head"></h3>\n <div data-str="actionsandevents_timerevents_desc"></div>\n\n <br>\n <div id="onPageTimerContainer"></div> \n</div>\n\n\n\n<div class="greyBackgroundSection greyBackgroundSectionDynamicWidth" id="actionsandevents-event-simulator">\n <h3 class="blueheading noTopMarginHeader">Event Simulator</h3>\n <div>Here you can simulate events.</div>\n\n <br>\n\n <table>\n <tr>\n <td>\n <div id="buttonSimulateFollow"></div>\n </td>\n <td>\n <div id="buttonSimulateShare"></div>\n </td>\n <td>\n <div id="buttonSimulateSubscribe"></div>\n </td>\n <td>\n <div id="buttonSimulateLike"></div>\n </td>\n </tr>\n </table>\n\n <table>\n <tr>\n <td>\n <div id="selectBoxSimulateGift"></div>\n </td>\n <td>\n <div id="buttonSimulateGift"></div>\n </td>\n </tr>\n </table> \n</div>\n\n\n<br><br><br><br>\n\n\x3c!-- Template --\x3e\n<div class="newActionTemplate hidden">\n\n <div data-str="actionsandevents_actions_modal_action_name"></div>\n\n <div class="dxForm">\n <div class="form">\n <div class="dx-fieldset">\n <div class="dx-field">\n  <div class="dx-field-label">\n  <div class="actionNameTextbox"></div>\n  <div style="margin-top: 5px;" class="hidden error actionNameExistsError" data-str="actionsandevents_actions_modal_error_exists"></div>\n  </div>\n  <div class="dx-field-value">\n\n  </div>\n </div>\n </div>\n </div>\n </div>\n\n\n <div data-str="actionsandevents_actions_modal_action_action"></div>\n <div class="dxForm">\n <div class="form">\n <div class="dx-fieldset">\n <div class="dx-field" data-actionType="showAnimation" data-checkboxLabel="actionsandevents_actions_modal_option_show