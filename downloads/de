ägt 1/24\n\n  <b>Wartezeit (Minuten)</b>\nNachdem ein Nutzer den <b class="cmdspin"></b>-Befehl ausgeführt hat, kann in diesem Feld definiert werden, wie lange der Zuschauer bis zur nächsten Ausführung warten muss. Wenn keine Wartezeit bestehen soll, trage dort 0 ein.\n\n',wheel_help_head:"Das Glücksrad",wheel_help_link:"Was bedeuten diese Einstellungen?",wheel_main_win:"Hauptgewinn",wheel_main_win_action:"Aktion bei Hauptgewinn",wheel_max_normal_win:"Maximaler Normalgewinn"}}}</script><script>window.logInitError=function(n){try{n.channelId=localStorage.getItem("setting_channelid")||0}catch(o){n.channelId=0}try{fetch("/api/logError",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(n)})}catch(o){console.error("Error logging init error:",o)}},window.onerror=function(n,o,t,e,r){window.hasErrors=!0;try{document.getElementsByClassName("loadingSpinner")[0].style.display="none",document.getElementsByClassName("loadingStaticText")[0].innerHTML="<h1>Oh no! :(</h1>",document.getElementsByClassName("loadingStatus")[0].innerText=(n||"Unknown Error").toString()}catch(o){}if(!window.errorLogged){window.errorLogged=!0;try{window.logInitError({event:"APP_INIT_ERROR",message:n,file:o,line:t,column:e,pos:"window.onerror",stack:r?r.stack:null})}catch(o){window.logInitError({event:"APP_INIT_ERROR",message:n,pos:"window.onerror"})}}},setTimeout(()=>{window.appInitDone||window.errorLogged||(window.errorLogged=!0,window.logInitError({event:"APP_INIT_TIMEOUT_HARD",visibilityState:document.visibilityState,readyState:document.readyState,appInitStage:window.appInitStage||null,appBootStage:window.appBootStage||null,scriptCountTotal:window.scriptCountTotal,scriptCountLoaded:window.scriptCountLoaded,scriptCountFailed:window.scriptCountFailed}))},4e4)</script><div id="notificationPreferences" class="notification-preferences-modal" style="display:none"><div class="notification-preferences-content"><div class="notification-preferences-header"><button class="preferences