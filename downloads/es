l events.\n\n<br><br>\n\n<h3 class="blueheading">Example Code</h3>\n\n<div>\n <a href="/downloads/ws_api_example.zip" target="_blank"><i class="fas fa-download"></i> Download JavaScript Example</a>\n</div>\n\n<br><br>\n'},{name:"likeathon",hasHtml:!0,hasJs:!0,hasCss:!0,template:'<h2 class="blueheading" data-str="likeathon_head"></h2>\n\n<div data-str="likeathon_desc" style="max-width: 700px;"></div>\n\n<br>\n\n<div class="setupUnconnected">\n <div class="redNotification" style="cursor: pointer;" onclick="navigation.pageChange(\'setup\')">\n <div class="error" data-str="start_setup_required"></div>\n </div>\n <br>\n</div>\n\n<table>\n <tr>\n <td>\n <div class="greyBackgroundSection greyBackgroundSectionDynamicWidth" style="height: 210px;" id="likeathon-reduction">\n <h3 class="blueheading noTopMarginHeader" data-str="likeathon_head_decrease"></h3>\n <div>\n  <div class="dxForm">\n  <div class="form">\n  <div class="dx-fieldset">\n  <div class="dx-field">\n   <div class="dx-field-label" data-str="likeathon_enableDecrease"></div>\n   <div class="dx-field-value">\n   <div id="checkboxLikeathonEnableAutomaticDecrease"></div>\n   <div data-str="likeathon_hint1" id="likeathonHint1"></div>\n   </div>\n  </div>\n  <div class="dx-field">\n   <div class="dx-field-label" data-str="likeathon_decreaseSpeed"></div>\n   <div class="dx-field-value">\n   <div id="sliderLikeathonDecreaseSpeed"></div>\n   <div id="likeathonIntensityValue">-</div>\n   </div>\n  </div>\n  </div>\n  </div>\n  </div>\n </div>\n </div>\n </td>\n <td>\n <div class="greyBackgroundSection greyBackgroundSectionDynamicWidth" style="height: 210px; width: 200px;" id="likeathon-reset">\n <h3 class="blueheading noTopMarginHeader" data-str="likeathon_head_reset"></h3>\n\n <br>\n <div id="buttonLikeathonReset" style="margin-left: 20px;"></div>\n </div>\n </td>\n </tr>\n</table>\n\n<div class="greyBackgroundSection greyBackgroundSectionOverlayFix" style="margin-top: -20px;" id="likeathon-topliker">\n <h3 class="bluehea