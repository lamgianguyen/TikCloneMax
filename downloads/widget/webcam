        function replaceWithVideo(src, opts = {}) {
            const $slot = $("#slot");
            $slot.empty();

            const $v = $("<video playsinline>").attr("autoplay", true);

            if (opts.muted) $v.prop("muted", true);
            if (opts.loop) $v.prop("loop", true);
            if (opts.controls) $v.prop("controls", true);
            $v.css(style);
            $v.append($("<source>").attr("src", src).attr("type", "video/webm"));
            $slot.append($v);
            applyAppearance($v);
        }

        function replaceWithIframe(url) {
            const $slot = $("#slot");
            $slot.empty();

            const $f = $("<iframe>").attr("src", url)
                .attr("frameborder", "0").attr("allow", "autoplay")
                .css({ position: "absolute", inset: 0, width: "100%", height: "100%" });

            $slot.append($f);
        }

        function replaceWithImage(src) {
            const $slot = $("#slot");
            $slot.empty();

            const $img = $("<img>")
                .attr("src", src)
                .css(style);

            $slot.append($img);
            applyAppearance($img);
        }

        function applyAppearance($el) {
            const grayscalefilter = state.grayScaleFilter;
            // Default saturation to 50 (= saturate 100%, full color) when unset/NaN.
            // Bundle schema default is 50; without this an unconfigured graphic overlay
            // renders saturate(0%) = grayscale in OBS / an external browser (where
            // window.settings lacks the bundle's defaults). Explicit values respected.
            const _satRaw = state.saturationFilter;
            const saturationfilter = (_satRaw == null || isNaN(parseInt(_satRaw))) ? 50 : parseInt(_satRaw);
            const huefilter = state.hueFilter;

            const filters = `hue-rotate(${(parseInt(huefilter) || 0) * 3.6}deg) saturate(${parseInt(saturationfilter || 0) * 2}%) grayscale(${grayscalefilter || 0}%)`;
            $el.css("filter", filters).css("opacity", 1).css("mix-blend-mode", "normal");
        }

        function previewUrl(url, hasPro) {
            const extensions = ['.webm', '.png']
                if (settings && !settings.isPro && hasPro) {
                    for (const ext of extensions) {
                    if (url.endsWith(ext)) {
                        return url.replace(ext, `_wm${ext}`);
                    }
                }
            }

            return url;
        }

        const render = () => {
            const variation = state.variation;
            const version = `${type}_${variation}`.replace(/\s+/g, "_");
            const isAnimated = state.animation;
            const cfg = ASSET_MAP[version];
            // Unknown/unset variation (e.g. OBS/browser before settings arrive) → cfg
            // is undefined; skip render instead of crashing on cfg.pro/cfg.video (which
            // left the overlay blank). Renders normally once a valid variation is set.
            if (!cfg) return;

            if (cfg.pro) {
                maybeToggleSplash(needSplash());
            }

            if (isAnimated) {
                replaceWithVideo(previewUrl(cfg.video, cfg.pro), { muted: true, loop: true });
            } else {
                replaceWithImage(previewUrl(cfg.image, cfg.pro))
            }
        }

        const intializeWidget = () => {
            function waitForSessionReady() {
                return new Promise(resolve => {
                    const check = () => {
                        const ready = settings !== null;
                        if (ready) {
                            resolve();
                        } else {
                            setTimeout(check, 50);
                        }
                    };

                    check();
                });
            }

            waitForSessionReady().then(() => {
                const variation = sGet("variation") !== '' ? sGet("variation") : DEFAULT_MAP[WIDGET_ID];
                const animation = sGet("animation");
                const grayScaleFilter = parseInt(sGet('grayScaleFilter'));
                const saturationFilter = parseInt(sGet('saturationFilter'));
                const hueFilter = parseInt(sGet('hueFilter'));

                if (variation !== null) {
                    state.variation = variation;
                }
                state.animation = animation;
                state.grayScaleFilter = grayScaleFilter;
                state.saturationFilter = saturationFilter;
                state.hueFilter = hueFilter;

                render();
            })
        }
        
        function updateWidgetSettings (wSettings) {
            let hasChanges = false;
            const variation = wSettings[`${WIDGET_ID}_variation`];
            const animation = wSettings[`${WIDGET_ID}_animation`];
            const grayScaleFilter = parseInt(wSettings[`${WIDGET_ID}_grayScaleFilter`]);
            const hueFilter = parseInt(wSettings[`${WIDGET_ID}_hueFilter`]);
            const saturationFilter = parseInt(wSettings[`${WIDGET_ID}_saturationFilter`]);

            if (state.variation !== variation) {                
                state.variation = variation;
                hasChanges = true;
            }
            
            if (state.animation !== animation) {                
                state.animation = animation;
                hasChanges = true;
            }
            if (state.hueFilter !== hueFilter && !isNaN(hueFilter)) {                
                state.hueFilter = hueFilter;
                hasChanges = true;

            }
            if (state.saturationFilter !== saturationFilter && !isNaN(saturationFilter)) {                
                state.saturationFilter = saturationFilter;
                hasChanges = true;
            }

            if (state.grayScaleFilter !== grayScaleFilter && !isNaN(grayScaleFilter)) {
                state.grayScaleFilter = grayScaleFilter;
                hasChanges = true;
            }

            if (hasChanges) {
                render();
            }
        }

        window.addEventListener("load", (e) => {
            intializeWidget();
            io.on("widgetSettings", updateWidgetSettings)
        });

        // [Preview fallback — clone] The in-app preview shares localStorage
        // (same origin) with the control page, which writes the chosen variation
        // on EVERY carousel switch (settings.set -> setting_widget_<id>_variation).
        // The normal POST/updateSettings -> socket broadcast push that should
        // deliver it here is unreliable in the clone (the renderer POST aborts,
        // "API Error -1"), so the preview never re-rendered. Read the variation
        // straight from localStorage and re-render on change — guarantees the
        // preview tracks the carousel. preview=1 ONLY, so OBS/live (which has its
        // OWN localStorage and relies on the socket broadcast) is unaffected.
        if (location.href.includes('preview=1')) {
            setInterval(() => {
                try {
                    const lv = localStorage.getItem('setting_widget_' + WIDGET_ID + '_variation')
                            || localStorage.getItem('setting_' + WIDGET_ID + '_variation');
                    const la = localStorage.getItem('setting_widget_' + WIDGET_ID + '_animation')
                            || localStorage.getItem('setting_' + WIDGET_ID + '_animation');
                    let changed = false;
                    if (lv && state.variation !== lv) { state.variation = lv; changed = true; }
                    if (la != null) {
                        const ab = (la === 'true' || la === true);
                        if (state.animation !== ab) { state.animation = ab; changed = true; }
                    }
                    if (changed) render();
                } catch (_) {}
            }, 400);
        }
    </script>
</head>

<body>
    <div id="slot" style="position:absolute; inset:0;"></div>
</body>

