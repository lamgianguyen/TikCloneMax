    <style>
        body {
            overflow: hidden;
            font-family: "Apple Color Emoji", "Segoe UI Emoji", "NotoColorEmoji", "Segoe UI Symbol", "Android Emoji", sans-serif;
        }

        #emoji-container {
            position: relative;
        }
    </style>
</head>

<body>
    <div id="emoji-container"></div>

    <!-- Include jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Function to extract emojis from a text
        function extractEmojis(text) {
            const emojiRegex = /[\u{1F300}-\u{1F5FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{1F700}-\u{1F77F}\u{1F780}-\u{1F7FF}\u{1F800}-\u{1F8FF}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FA6F}\u{1FA70}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}]/gu;
            return text.match(emojiRegex) || [];
        }

        // Function to animate emojis using jQuery
        function animateEmoji(emoji, baseEndPos, delay, numEmojis, isEmote) {
            let $emojiElement = null;
            let isImage = emoji.indexOf('https://') === 0;

            $('.emoji').css('transition', 'transform ' + (settings.emojify_animationDuration || 3) + 's');

            if (isImage) {
                $emojiElement = $('<img>').addClass('emoji').attr("src", emoji).css('border-radius', '50%').attr('onerror', "this.src='/img/nothumb.webp'");
            } else {
                $emojiElement = $('<div>').addClass('emoji').text(emoji);
            }

            $('#emoji-container').append($emojiElement);

            // Define initial position and size
            const initialSize = 0;
            const roationDirection = Math.random() > 0.5 ? 360 : -360;
            const finalSize = settings.emojify_emojiSize || 50; // in pixels, increased size for better visibility
            const startBaseLeft = $(window).width() / 2; // Base start position in the center
            const startPos = {
                top: $(window).height() - 20,
                left: startBaseLeft + (Math.random() * 200 - 100) // Variation up to 200px in width
            };

            // Slightly adjust end position for each emoji to prevent overlapping
            let variation = 150 * (numEmojis / 4); // pixels, increased for a more dynamic effect

            if (variation > 500) {
                variation = 500;
            }

            const endPos = {
                top: baseEndPos.top + (Math.random() * variation - variation / 2),
                left: baseEndPos.left + (Math.random() * variation - variation / 2)
            };

            // Set initial CSS properties
            $emojiElement.css({
                position: 'absolute',
                fontSize: initialSize,
                width: isImage ? initialSize : 'unset',
                top: startPos.top,
                left: startPos.left,
                opacity: 0, // Start with an opacity of 0
                transform: 'rotate(0deg)'
            });

            // Delay the start of the animation
            setTimeout(function () {
                $emojiElement.css({ opacity: (settings.emojify_opacity / 100) || 1 }); // Make emoji visible

                $emojiElement.css({
                    transform: `rotate(${(settings.emojify_rotations || 4) * roationDirection}deg)`
                });

                let width = 'unset';
                if (isImage) {
                    if (isEmote) {
                        width = settings.emojify_emoteSize || 70;
                    } else {
                        width = settings.emojify_profilePictureSize || 50;
                    }
                }

                // Animate properties: size, position, and opacity
                $emojiElement.animate({
                    fontSize: finalSize,
                    width: width,
                    top: endPos.top,
                    left: endPos.left
                }, (settings.emojify_animationDuration || 3) * 1000, 'swing') // Increased duration and easing for smoother animation
                    .animate({
                        opacity: 0
                    }, (settings.emojify_disappearAfter || 1) * 1000, function () { // Slower fade-out
                        // Remove the emoji after animation ends
                        $(this).remove();
                    });
            }, delay);
        }

        // onChatMessage function
        function onChatMessage(baseEndPos, message, profilePictureUrl) {
            const emojis = extractEmojis(message);

            let showProfilePictureCount = 1;

            emojis.forEach((emoji, index) => {
                // Delay each emoji by an additional 500ms for more pronounced effect
                const delay = (emojis.length < 5 ? 200 : 100) * index;
                animateEmoji(emoji, baseEndPos, delay, emojis.length);

                showProfilePictureCount += 1;
                if (showProfilePictureCount == 2 && settings.emojify_showPictures !== false) {
                    showProfilePictureCount = 0;
                    animateEmoji(profilePictureUrl, baseEndPos, delay, emojis.length);
                }
            });
        }

        function onEmotes(baseEndPos, emotes, profilePictureUrl) {

            let showProfilePictureCount = 1;

            emotes.forEach((emote, index) => {
                // Delay each emoji by an additional 500ms for more pronounced effect
                const delay = (emotes.length < 5 ? 200 : 100) * index;
                animateEmoji(emote.emoteImageUrl, baseEndPos, delay, emotes.length, true);

                showProfilePictureCount += 1;
                if (showProfilePictureCount == 2 && settings.emojify_showPictures !== false) {
                    showProfilePictureCount = 0;
                    animateEmoji(profilePictureUrl, baseEndPos, delay, emotes.length);
                }
            });
        }

        $(window).on("load", () => {
            io.on("chat", (chatData) => {
                if (!chatData.isTest) {
                    previewEnabled = false;
                }

                // if (!chatData.isTest && !settings.isPro) {
                //     return;
                // }

                const baseEndPos = {
                    top: Math.random() * $(window).height() / 2,
                    left: Math.random() * $(window).width()
                };

                if (settings.emojify_showEmojis !== false && chatData.comment)
                    onChatMessage(baseEndPos, chatData.comment, chatData.profilePictureUrl || 'https://');

                if (settings.emojify_showSubEmotes !== false && Array.isArray(chatData.emotes))
                    onEmotes(baseEndPos, chatData.emotes, chatData.profilePictureUrl || 'https://');
            });
        });

        let previewIndex = 0;
        let previewEnabled = true;

        function preview() {
            if (!previewEnabled) return;
            previewIndex += 1;

            if (previewIndex === 2) {
                io.fakeEmit("chat", { isTest: true, userId: 0, uniqueId: "JustinR", comment: "HAHAHA 😂😂😂😂", profilePictureUrl: "https://p16-useast2a.tiktokcdn.com/tos-useast2a-avt-0068-euttp/0293afb50ea774887553809331d3779d~c5_100x100.webp" });
            }

            if (previewIndex === 10) {
                io.fakeEmit("chat", { isTest: true, userId: 0, uniqueId: "Marcofo", comment: "Party!!! 🥳🥳🥳🎉🎉🎉🍾🍾🍾🥂🥂🥂", profilePictureUrl: "https://p77-va.tiktokcdn.com/musically-maliva-obj/1666074441196550~c5_100x100.webp" })
            }

            if (previewIndex === 20) {
                io.fakeEmit("chat", { isTest: true, userId: 0, uniqueId: "Hexor", comment: "OMG I LOVE IT ❤️❤️❤️💚💚💚💙💙💙🧡🧡🧡💜💜💜", profilePictureUrl: "https://p16.tiktokcdn-us.com/tos-useast5-avt-0068-tx/9700c28b7c97023f49711dcef0c1592a~c5_100x100.webp" })
            }

            if (previewIndex === 28) {
                io.fakeEmit("chat", {
                    isTest: true, userId: 0, uniqueId: "Miaru", comment: "Happy new Year! 🎆🎆🎆🎆🎇🎇🎇🎇", profilePictureUrl: "https://p16-useast2a.tiktokcdn.com/tos-useast2a-avt-0068-euttp/0293afb50ea774887553809331d3779d~c5_100x100.webp",
                    emotes: [
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 0
                        },
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 1
                        },
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 2
                        },
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 3
                        },
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 4
                        },
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 5
                        },
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 6
                        },
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 7
                        },
                        {
                            "emoteId": "7264991190683077408",
                            "emoteImageUrl": "https://p19-webcast.tiktokcdn.com/img/gcp/webcast-gcp-giso-euttp/sub_471f01460f13ae25fc474a416bf9cbad6eb0a88ea6e6090dc45baa47dde4461c~tplv-cpex7tcyqo-webp.webp",
                            "placeInComment": 8
                        }
                    ]
                })
            }

            if (previewIndex === 38) {
                previewIndex = 0;
            }
        }

    </script>
