    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/js/guard/obf/trc.js"></script>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.1/socket.io.min.js" crossorigin="anonymous"></script>

    <script src="sharedio/sharedio.js"></script>
    <script src="socketioclient.js?v=10"></script>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            overflow-x: hidden;
            margin-top: 20px !important;
            zoom: 150%;
            font-weight: bold;
        }

        .rankId {
            font-size: 1.3em;
            font-weight: bold;
            width: 30px;
            text-align: center;
        }

        .username {
            font-weight: bold;
            padding-left: 5px;
            padding-right: 5px;
            margin-left: -5px;
        }

        .points {
            padding-left: 10px;
            padding-right: 5px;
            margin-left: -5px;
        }

        .userlevel {
            font-weight: bold;
            font-size: 1.3em;
            margin-top: -4px;
            margin-bottom: -20px;
            margin-right: 5px;
        }

        img {
            border-radius: 50%;
            margin-right: 3px;
        }

        td {
            vertical-align: top;
        }

        .crown1 {
            position: fixed;
            height: 45px;
            margin-top: -27px;
            margin-left: 2px;
        }

        #userScore {
            position: absolute;
            margin-left: -15px;
        }

        #commands,
        #customCommands,
        #commandResult {
            margin-top: -14px;
            font-size: 0.9em;
            position: absolute;
        }

        #content {
            width: 800px;
            margin-left: 20px;
        }

        .box {
            padding-top: 3px;
            background-color: rgba(33, 33, 33, 0.4);
            padding-left: 10px;
            padding-right: 10px;
            padding-bottom: 5px;
            border-radius: 5px;
        }
    </style>

    <script>

        var queue = [];
        var isDisplaying = false;
        var nothumb = "https://ynassets.younow.com/yn-web/live/assets/images/icon-user.svg";

        function hideAll() {
            $("#content").hide();
            $("#userScore").hide();
            $("#userScore").find(".crown1").hide();
            $("#commands").hide();
            $("#customCommands").hide();
            $("#commandResult").hide();
        }

        function displayItem(item) {
            isDisplaying = true;

            var minDisplayDuration = 3000;
            var maxDisplayDuration = 6000;

            if (settings.commandinfo_showBoxShadow) {
                $("#commands").addClass("box");
                $("#customCommands").addClass("box");
                $("#commandResult").addClass("box");
                if (settings.commandinfo_boxShadowColor) $(".box").css("background-color", settings.commandinfo_boxShadowColor);
            } else {
                $("#commands").removeClass("box");
                $("#customCommands").removeClass("box");
                $("#commandResult").removeClass("box");
            }

            if (item.type === 2) {
                // set color
                if (settings.commandinfo_fontColor) $("#commands").css("color", settings.commandinfo_fontColor);
                if (settings.commandinfo_headerColor) $("#commands").find("b").css("color", settings.commandinfo_headerColor);

                // set text
                $("#commands").find(".commandsTemplate").html(item.commandsText);
                $("#commands").show();
            }

            if (item.type === 4) {
                // set color
                if (settings.commandinfo_fontColor) $("#customCommands").css("color", settings.commandinfo_fontColor);
                if (settings.commandinfo_headerColor) $("#customCommands").find("b").css("color", settings.commandinfo_headerColor);

                $("#customCommandsHeader").text("Global Commands:");

                if (item.whichUserId === 3) {
                    $("#customCommandsHeader").text("Subscriber Commands:");
                }

                if (item.whichUserId === 2) {
                    $("#customCommandsHeader").text("@" + item.username + "'s Commands:");
                }

                // set text
                $("#customCommands").find(".commandsTemplate").html(item.commandsText);

                if ($("#customCommands").find(".commandsTemplate").text().length > 50) {
                    minDisplayDuration = minDisplayDuration * 2.5;
                    maxDisplayDuration = maxDisplayDuration * 2;
                }

                $("#customCommands").find(".price").css("color", settings.commandinfo_priceColor)
                $("#customCommands").show();
            }

            if (item.type === 3) {
                if (settings.commandinfo_fontColor) $("#commandResult").css("color", settings.commandinfo_fontColor);

                $("#commandResult").find(".commandResultTemplate").html(item.commandResult);

                if (settings.commandinfo_headerColor) $("#commandResult").find("b").css("color", settings.commandinfo_headerColor);

                // show
                $("#commandResult").show();
            }

            $("#content").show(200, () => {
                setTimeout(() => {
                    $("#content").hide(200, () => {
                        hideAll();
                        isDisplaying = false;
                    })

                    // if other items are queued, reduce the display duration
                }, queue.length > 0 ? minDisplayDuration : maxDisplayDuration)
            });

            let rtl = settings.commandinfo_rightToLeft;

            $('#commands').css('direction', rtl ? 'ltr' : 'initial');
            $('#commands').css('text-align', rtl ? 'right' : 'initial');
            $('#customCommands').css('direction', rtl ? 'ltr' : 'initial');
            $('#customCommands').css('text-align', rtl ? 'right' : 'initial');
            $('#commandResult').css('direction', rtl ? 'ltr' : 'initial');
            $('#commandResult').css('text-align', rtl ? 'right' : 'initial');
        }

        $(window).on("load", () => {


            io.on("showCommands", (commands) => {
                commands.type = 2;

                if (queue.length > 5) return;

                // skip if commands already queued
                if (queue.find(x => x.type === 2)) return;

                queue.push(commands)
            });

            io.on("showCustomCommands", (commands) => {
                commands.type = 4;

                if (settings.commandinfo_showCustomCommands === false) return;
                if (queue.length > 5) return;

                // skip if commands already queued
                if (queue.find(x => x.type === 4)) return;

                queue.push(commands)
            });

            io.on("showCommandResult", (result) => {
                result.type = 3;

                if (queue.length > 5) return;

                queue.push(result)
            });

            setTimeout(() => {
                hideAll();
            }, 100);
        });

        setInterval(() => {
            if (queue.length === 0) return;
            if (isDisplaying) return;

            displayItem(queue.shift());
        }, 100)

        let previewIndex = 0;
        let previewEnabled = true;

        function preview() {
            if (!previewEnabled) return;
            previewIndex += 1;

            if (previewIndex === 2) {
                io.fakeEmit('showCommands', {
                    "commandsText": "!score<br>!send [amount] [username]<br>!spin<br>"
                })
            }

            if (previewIndex === 20) {
                previewIndex = 0;
            }
        }
    </script>
</head>

<body>
    <div id="content">
        <div id="userScore">
            <table>
                <tr>
                    <td class="rankId">
                        1.
                    </td>
                    <td>
                        <img src="./img/gold_crown.svg" class="crown1" />
                        <img style="height: 50px; width: 50px;" class="profilePicture" onerror="this.src=nothumb" />
                    </td>
                    <td>
                        <table>
                            <tr>
                                <td>
                                    <div class="userlevel">0</div>
                                </td>
                                <td>
                                    <div class="username">Testuser</div>
                                </td>
                            </tr>
                        </table>

                        <div class="points">0 Points</div>

                    </td>
                </tr>
            </table>
        </div>

        <div id="commands">
            <b>Commands:</b>
            <div class="commandsTemplate">

            </div>
        </div>

        <div id="customCommands">
            <b id="customCommandsHeader">Custom Commands:</b>
            <div class="commandsTemplate">

            </div>
        </div>

        <div id="commandResult">
            <div class="commandResultTemplate">

            </div>
        </div>
    </div>


<script defer src="https://static.cloudflareinsights.com/beacon.min.js/v8c78df7c7c0f484497ecbca7046644da1771523124516" integrity="sha512-8DS7rgIrAmghBFwoOTujcf6D9rXvH8xm8JQ1Ja01h9QX8EzXldiszufYa4IFfKdLUKTTrnSFXLDkUEOTrZQ8Qg==" data-cf-beacon='{"version":"2024.11.0","token":"65f9075973884fc192143938ea377297","server_timing":{"name":{"cfCacheStatus":true,"cfEdge":true,"cfExtPri":true,"cfL4":true,"cfOrigin":true,"cfSpeedBrain":true},"location_startswith":null}}' crossorigin="anonymous"></script>
</body>

</html>