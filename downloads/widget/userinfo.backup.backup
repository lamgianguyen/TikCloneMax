    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/js/guard/obf/trc.js"></script>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.1/socket.io.min.js" crossorigin="anonymous"></script>

    <script src="sharedio/sharedio.js"></script>
    <script src="socketioclient.js?v=10"></script>

    <link rel="stylesheet" href="/css/text-effects.css">
    <script src="/js/text-effects.js"></script>
    <script src="/js/text-effects-integration.js"></script>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            overflow-x: hidden;
            margin-top: 15px !important;
            zoom: 150%;
        }

        .rankId {
            font-size: 1.3em;
            font-weight: bold;
            width: 30px;
            text-align: center;
            direction: ltr;
        }

        .username {
            font-weight: bold;
            padding-left: 5px;
            padding-right: 5px;
            margin-left: -5px;
        }

        .points {
            padding-left: 10px;
            padding-right: 5px;
            margin-left: -5px;
        }

        .userlevel {
            font-weight: bold;
            font-size: 1.3em;
            margin-top: -4px;
            margin-bottom: -20px;
            margin-right: 5px;
        }

        img {
            border-radius: 50%;
            margin-right: 3px;
        }

        td {
            vertical-align: top;
        }

        .crown1 {
            position: fixed;
            height: 45px;
            margin-top: -27px;
            margin-left: 2px;
        }

        #userScore {
            padding-top: 5px;
            position: absolute;
            margin-left: -15px;
        }

        #commands {
            margin-top: -14px;
            font-size: 0.9em;
            position: absolute;
        }

        #content {
            width: 800px;
            margin-left: 20px;
        }

        .box {
            background-color: rgba(33, 33, 33, 0.4);
            padding-left: 10px;
            padding-right: 10px;
            padding-bottom: 5px;
            border-radius: 5px;
        }
    </style>

    <script>

        var queue = [];
        var isDisplaying = false;
        var nothumb = "/img/nothumb.webp";

        function hideAll() {
            $("#content").hide();
            $("#userScore").hide();
            $("#userScore").find(".crown1").hide();
            $("#commands").hide();
        }

        function displayItem(item) {
            isDisplaying = true;

            if (settings.userinfo_showBoxShadow) {
                $("#userScore").addClass("box");
                if (settings.userinfo_boxShadowColor) $(".box").css("background-color", settings.userinfo_boxShadowColor);
            } else {
                $("#userScore").removeClass("box");
            }

            if (item.type === 1) {
                // set colors
                if (settings.userinfo_usernameColor) $("#userScore").find(".username").css("color", settings.userinfo_usernameColor);
                if (settings.userinfo_rankColor) $("#userScore").find(".rankId").css("color", settings.userinfo_rankColor);
                if (settings.userinfo_rankColor) $("#userScore").find(".points").css("color", settings.userinfo_pointsColor);
                if (settings.userinfo_levelColor) $("#userScore").find(".userlevel").css("color", settings.userinfo_levelColor);

                let rtlEnabled = settings.userinfo_rightToLeft;
                let subDirection = rtlEnabled ? 'ltr' : 'initial';
                let subAlign = rtlEnabled ? 'right' : 'initial';
                $('.username').css('direction', subDirection);
                $('.username').css('text-align', subAlign);
                $('.points').css('direction', subDirection);
                $('.points').css('text-align', subAlign);

                // set text
                $("#userScore").find(".userlevel").text(item.level);
                $("#userScore").find(".username").text(item.username);
                $("#userScore").find(".points").text(Math.floor(item.totalAmount).toLocaleString() + " " + settings.currencyName);
                $("#userScore").find(".profilePicture").attr("src", item.thumbnailUrl || getUserThumbnailUrlFromUserId(item.userId));

                if (window.TextEffectsIntegration) {
                    TextEffectsIntegration.applyUsernameEffects('userinfo', '.username', settings);
                }

                $("#userScore").show();

                if (item.rank === 1) $(".crown1").show();
                $("#userScore").find(".rankId").show().text(item.rank > 0 ? (item.rank + ".") : "");
            }


            $("#content").show(200, () => {
                setTimeout(() => {
                    $("#content").hide(200, () => {
                        hideAll();
                        isDisplaying = false;
                    })

                    // if other items are queued, reduce the display duration
                }, queue.length > 0 ? 3000 : 6000)
            });
        }

        $(window).on("load", () => {

            io.on("showUserScore", (userScore) => {
                userScore.type = 1;
                if (queue.length > 6) return;

                // skip if same user already in queue
                if (queue.find(x => x.type === 1 && x.userId === userScore.userId)) return;

                queue.push(userScore);
            });

            // => moved to command info overlay
            // io.on("showCommands", (commands) => {
            //     commands.type = 2;

            //     // skip if commands already queued
            //     if (queue.find(x => x.type === 2)) return;

            //     queue.push(commands)
            // });

            setTimeout(() => {
                hideAll();
            }, 100);

        });

        setInterval(() => {
            if (queue.length === 0) return;
            if (isDisplaying) return;

            displayItem(queue.shift());
        }, 100)

        let previewIndex = 0;
        let previewEnabled = true;

        function preview() {
            if (!previewEnabled) return;
            previewIndex += 1;

            if (previewIndex === 2) {
                io.fakeEmit("showUserScore", { userId: -1, username: "Zerody", totalAmount: 123456, level: 90, rank: 1, thumbnailUrl: "https://p16-useast2a.tiktokcdn.com/tos-useast2a-avt-0068-giso/4ec174248f94de26938f73874962469b~c5_100x100.jpeg" })
            }

            if (previewIndex === 15) {
                io.fakeEmit("showUserScore", { userId: -1, username: "Tester", totalAmount: 500, level: 12, rank: 1, thumbnailUrl: "https://p16-useast2a.tiktokcdn.com/tos-useast2a-avt-0068-euttp/d3b0b619b215f34beb8f1cb9ea2720b6~tplv-tiktok-shrink:72:72.webp" })
            }

            if (previewIndex === 25) {
                previewIndex = 0;
            }
        }
    </script>
</head>

<body>
    <div id="content">
        <div id="userScore">
            <table>
                <tr>
                    <td class="rankId">
                        1.
                    </td>
                    <td>
                        <img src="./img/gold_crown.svg" class="crown1" />
                        <img style="height: 50px; width: 50px;" class="profilePicture" onerror="this.src=nothumb" />
                    </td>
                    <td>
                        <table>
                            <tr>
                                <td>
                                    <div class="userlevel">0</div>
                                </td>
                                <td>
                                    <div class="username">Testuser</div>
                                </td>
                            </tr>
                        </table>

                        <div class="points">0 Points</div>

                    </td>
                </tr>
            </table>
        </div>

        <div id="commands">
            <b>Commands:</b>
            <div class="commandsTemplate">

            </div>
        </div>
    </div>


<script defer src="https://static.cloudflareinsights.com/beacon.min.js/v8c78df7c7c0f484497ecbca7046644da1771523124516" integrity="sha512-8DS7rgIrAmghBFwoOTujcf6D9rXvH8xm8JQ1Ja01h9QX8EzXldiszufYa4IFfKdLUKTTrnSFXLDkUEOTrZQ8Qg==" data-cf-beacon='{"version":"2024.11.0","token":"65f9075973884fc192143938ea377297","server_timing":{"name":{"cfCacheStatus":true,"cfEdge":true,"cfExtPri":true,"cfL4":true,"cfOrigin":true,"cfSpeedBrain":true},"location_startswith":null}}' crossorigin="anonymous"></script>
</body>

</html>