<body>
    <iframe></iframe>

    <script>
        let params = new URLSearchParams(window.location.search);
        let dockId = params.get('did');
        let iframe = document.querySelector("iframe");

        iframe.addEventListener("load", () => {
            if (window.location.href.includes("preview=1")) {
                iframe.contentDocument.body.style.backgroundColor = "transparent";
            }
        });

        iframe.src = `./vite/src/activity-feed/?dockId=${dockId}&cid=${params.get('cid')}`;

        io.on("dockData", (event) => {
            if (!window.location.href.includes("preview=1")) {
                iframe.contentWindow.postMessage(event, "*");
            }
        });

        window.addEventListener("message", (event) => {
            if (event.data && typeof event.data === "object" && event.data.type && event.data.payload) {
                iframe.contentWindow.postMessage(event.data, "*");
            }
        });
    </script>
