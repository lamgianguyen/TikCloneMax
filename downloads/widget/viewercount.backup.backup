    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/js/guard/obf/trc.js"></script>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.1/socket.io.min.js" crossorigin="anonymous"></script>

    <script src="sharedio/sharedio.js"></script>
    <script src="socketioclient.js?v=10"></script>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            overflow-x: hidden;
            zoom: 1.4;
        }

        #content {
            width: fit-content;
            padding: 10px;
            padding-top: 3px;
            padding-bottom: 5px;
            display: none;
            border-radius: 10px;
        }
    </style>

    <script>
        let viewerCount = 0;

        $(window).on("load", () => {
            io.on("updateViewerCount", (obj) => {
                viewerCount = obj.viewerCount;
                update();
            });

            updateSettings();
        });

        function update() {
            let extra = "";

            if (settings && settings.viewercount_tiktokText) {
                extra = "TikTok Viewers: ";
            }

            if (viewerCount) {
                $('#content').css('display', 'block');
                $("#viewercount").text(extra + viewerCount.toLocaleString());
            } else {
                $('#content').css('display', 'none');
                $("#viewercount").text("");
            }
        }

        function updateSettings() {
            if (!settings) {
                return;
            }

            $('#content').css('background-color', settings.viewercount_backgroundColor || 'rgba(40, 40, 40, 0.8)');
            $('#content').css('color', settings.viewercount_textColor || '#ebebeb');

            if (settings.viewercount_enableBorder) {
                $('#viewercount').css("text-shadow", `${settings.viewercount_borderColor} 1px 1px 1px`);
            } else {
                $('#viewercount').css("text-shadow", 'inherit');
            }

            update();
        }


        function preview() {
            if (viewerCount === 0) {
                viewerCount = 1234;
                update();
            }
        }
    </script>
</head>

<body>
    <div id="content">
        <div id="viewercount"></div>
    </div>
