        async function maybeToggleSplash(show) {
            const slot = document.getElementById("slot");
            if (!slot) return;
            if (show) {
                await loadScript("/widget/splash.js"); // pad naar bestand
                TFSplash.show({
                    img: "/img/finty-huh.png",
                    heading: "Oops! Your asset needs an upgrade",
                    html: `Your TikFinity Pro subscription has expired - reactivate it to <span>instantly bring your <strong>overlay frame</strong> back to life. ❤️</span>`
                });
                slot.classList.add("hidden");
            } else {
                if (window.TFSplash) TFSplash.hide();
                slot.classList.remove("hidden");
            }
        }

        // Helpers
        function sGet(name, fallback = null) {
            try {
                const key = `${WIDGET_ID}_${name}`;
                if (window.settings?.get) return window.settings.get(key) ?? fallback;
                return window.settings?.[key] ?? fallback;
            } catch {
                return fallback;
            }
        }

        function toggleSplashScreen(isVisible) {
            const splash = document.querySelector(".splash-screen");
            const slot = document.getElementById("slot");
            if (!splash || !slot) return;

            splash.classList.toggle("hidden", !isVisible);
            slot.classList.toggle("hidden", isVisible);
