<!DOCTYPE html>
<html lang="en">

<head>

<!-- [TIKFINITY BROWSER STUB] -->
<script>
  if (typeof window.require === 'undefined') {
    window.require = function(moduleName) {
      console.log('[Stub] require called for:', moduleName);
      if (moduleName === 'electron') {
        return {
          ipcRenderer: {
            send: function() { console.log('[Stub] ipcRenderer.send', arguments); },
            sendSync: function() { console.log('[Stub] ipcRenderer.sendSync', arguments); return null; },
            on: function() { console.log('[Stub] ipcRenderer.on', arguments); },
            once: function() { console.log('[Stub] ipcRenderer.once', arguments); },
            removeListener: function() { console.log('[Stub] ipcRenderer.removeListener', arguments); },
            removeAllListeners: function() { console.log('[Stub] ipcRenderer.removeAllListeners', arguments); },
            invoke: function() { console.log('[Stub] ipcRenderer.invoke', arguments); return Promise.resolve({}); }
          },
          clipboard: {
             writeText: function(t) { console.log('[Stub] clipboard.writeText', t); window.navigator.clipboard?.writeText(t); },
             readText: function() { return ''; }
          },
          shell: {
             openExternal: function(url) { console.log('[Stub] shell.openExternal', url); window.open(url, '_blank'); }
          }
        };
      }
      return null;
    };
  }
  if (typeof window.ipcRenderer === 'undefined') {
    window.ipcRenderer = window.require('electron').ipcRenderer;
  }
  if (typeof process === 'undefined') {
    window.process = { env: {}, platform: 'browser', type: 'renderer', versions: {} };
  }

</script>
<!-- [/TIKFINITY BROWSER STUB] -->

    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/js/guard/obf/trc.js"></script>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.1/socket.io.min.js" crossorigin="anonymous"></script>

    <script src="sharedio/sharedio.js"></script>
    <script src="socketioclient.js?v=10"></script>

    <link rel="stylesheet" href="/css/text-effects.css">
    <script src="/js/text-effects.js"></script>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            overflow-x: hidden;
            width: 100%;
        }

        .goalContainer {
            width: calc(100vw - 60px);
            text-align: center;
            align-items: center;
            margin-left: 15px;
        }
        
        .own3d .goalContainer{
            position: relative;
        }
        
        

        .progressContainer {
            width: 100%;
            height: 30px;
            padding: 10px;
            overflow: hidden;
        }

        .textContainer {
            display: table;
            width: fit-content;
            padding-bottom: 5px;
            padding-right: 30px;
            padding-left: 20px;
            white-space: nowrap;
            overflow: hidden;
        }

        .background {
            background-color: #1e7b92;
        }

        .font {
            color: #fff;
            font-size: 1.5em;
        }

        .progressBar {
            width: 100%;
            height: 100%;
            background-color: #2cb2d4;
        }

        .progressBarProgress {
            width: 0%;
            height: 100%;
            background-color: #d42c65;
        }

        .progressBarProgressPercent {
            position: absolute;
            top: 8px;
            width: 100%;
            text-align: center;
            color: #fff;
            font-weight: bold;
            font-size: 1.5em;
        }
        
        .goalContainerOverlay{
            width:100%;
            height: auto;
            margin-top: -1rem;
            margin-bottom: -1rem;
            display: block;
            z-index: 100;
            position: relative;
        }
        
        .progressBarTitle{
            padding-left: 2.7rem;
            padding-right: 2.7rem;
            white-space: nowrap;
            margin-bottom: 0.25rem
        }
        
        .own3d{
            position: relative;
        }
        
        .own3d .font{
            font-size: var(--design-font-size);
        }
        
        .own3d .progressBar{
            position: absolute;
            top: 3.5vw;
            left: 3.5vw;
            bottom: 3.5vw;
            right: 3.5vw;
            width: unset;
            height: unset;
        }
        
        .own3d.variation-pure .progressBar{
            position: absolute;
            top: 1.5vw;
            left: 2vw;
            bottom: 1.5vw;
            right: 2vw;
            width: unset;
            height: unset;
        }
        .layout-standard .progressBarTextContainer, .layout-condensed .progressBarTextContainer{
            position: absolute;
            width: 100%;
            top: 50%;
            left: 0;
            transform: translateY(-50%);
            display: flex;
            justify-content: space-between;
            padding: 0 5vw;
            box-sizing: border-box;
        }

        .variation-aurous.layout-standard .progressBarTextContainer, .variation-aurous.layout-condensed .progressBarTextContainer{
            padding: 0 6.5vw;
        }
        
        .layout-simple .progressBarTextContainer{
            display: none;
        }
        .layout-standard .progressBarTitle{
            padding-left:5vw;
        }
        .layout-simple .progressBarTitle,.layout-condensed .progressBarTitle{
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%) !important;
            text-align: center;
            z-index: 200;
        }
        .own3d.layout-simple .progressBar, .own3d.layout-condensed .progressBar{
           
        }

        .flip {
            animation: flipAnimation 1s;
            animation-fill-mode: backwards;
        }

        .shake {
            animation: shake 0.5s;
            animation-iteration-count: infinite;
        }

        @keyframes flipAnimation {
            0% {
                transform: rotateX(0deg);
            }

            50% {
                transform: rotateX(180deg);
            }

            100% {
                transform: rotateX(0deg);
            }
        }

        @keyframes shake {
            0% {
                transform: translate(1px, 1px) rotate(0deg);
            }

            10% {
                transform: translate(-1px, -2px) rotate(-1deg);
            }

            20% {
                transform: translate(-3px, 0px) rotate(1deg);
            }

            30% {
                transform: translate(3px, 2px) rotate(0deg);
            }

            40% {
                transform: translate(1px, -1px) rotate(1deg);
            }

            50% {
                transform: translate(-1px, 2px) rotate(-1deg);
            }

            60% {
                transform: translate(-3px, 1px) rotate(0deg);
            }

            70% {
                transform: translate(3px, 1px) rotate(-1deg);
            }

            80% {
                transform: translate(-1px, -1px) rotate(1deg);
            }

            90% {
                transform: translate(1px, 2px) rotate(0deg);
            }

            100% {
                transform: translate(1px, -2px) rotate(-1deg);
            }
        }
        
        .hidden{
            display: none !important;
        }
    </style>

    <script>
        var goalMetric = new URLSearchParams(location.search).get("metric");
        var currentProgressbarValue = 0;
        var progressBarUpdateInterval = null;
        var testing = false;
        var init = false;
        var lastGoalValue = 0;
        var lastPercentValue = 0;
        var hideTimeout = null;
        var loadingTimeout = setTimeout(() => {
            $(".goalText").text("Please start TikFinity");
        }, 10000);

        function getSetting(settingName) {
            return settings["goal" + goalMetric + "_" + settingName];
        }
        
        function updateFontSize(){
            const vwValue = window.innerWidth * 0.035; // 3vw in pixels
            const remValue = 1 + ((getSetting("fontSize") - 50) * 0.01);
            const multiplied = (vwValue * remValue); // Convert back to rem

            document.documentElement.style.setProperty('--design-font-size', `${multiplied}px`);
        }
        window.addEventListener('resize', updateFontSize);

        function updateSettings(hasChanges) {
            if (!settings) return;

            let variation = getSetting("variation") || "default"
            //let variation = "pure"
            
            if (!settings.isPro && !location.href.includes('preview=1')){
                variation = "default"; //force legacy design for free users
            }
            
            const isOwn3dDesign = ["army", "clean-neon", "pure", "raven", "aurous", "clarity"].includes(variation);
            
            if (isOwn3dDesign) {
                // remove hidden class
                $(".own3d").removeClass("hidden");
                $(".legacy").addClass("hidden");
                $(".own3d").removeClass (function (index, className) {
                    return (className.match (/(^|\s)variation-\S+/g) || []).join(' ');
                });
                $(".own3d").addClass(`variation-${variation}`);
                updateFontSize()
            } else {
                $(".own3d").addClass("hidden");
                $(".own3d").removeClass (function (index, className) {
                    return (className.match (/(^|\s)variation-\S+/g) || []).join(' ');
                });
                $(".legacy").removeClass("hidden");
                //reset font size
                document.documentElement.style.setProperty('--design-font-size', ``);
            }
            
            const layout = getSetting("layout") || "standard"; // standard / simple / condensed
            const filters  = `hue-rotate(${(getSetting('hueFilter')||0)*3.6}deg) saturate(${parseInt(getSetting("saturationFilter")||0)*2}%) grayscale(${getSetting("grayScaleFilter")||0}%)`;
            switch (variation){
                case "army":
                    $(".goalContainerOverlay").attr("src",'/img/widgets/goals/army.png').css("filter", filters);
                    $(".progressBar").css("background-color", getSetting("progress2Color"));
                    $(".progressBarProgress").css("background-color", getSetting("progress1Color"));
                    break;
                case "clean-neon":
                    $(".goalContainerOverlay").attr("src",'/img/widgets/goals/cleanneon.png').css("filter", filters);
                    $(".progressBar").css("background-color", getSetting("progress2Color"))
                    $(".progressBarProgress").css("background-color", getSetting("progress1Color"));
                    break;
                case "pure":

                    $(".goalContainerOverlay").attr("src",'/img/widgets/goals/pure.png').css("filter", filters);
                    $(".progressBar").css("background-color",getSetting("progress2Color"));
                    $(".progressBarProgress").css("background-color", getSetting("progress1Color"));
                    break;
                case "raven":

                    $(".goalContainerOverlay").attr("src",'/img/widgets/goals/raven.png').css("filter", filters);
                    $(".progressBar").css("background-color", getSetting("progress2Color"));
                    $(".progressBarProgress").css("background-color", getSetting("progress1Color"));
                    break;
                case "aurous":

                    $(".goalContainerOverlay").attr("src",'/img/widgets/goals/aurous.png').css("filter", filters);
                    $(".progressBar").css("background-color", getSetting("progress2Color"));
                    $(".progressBarProgress").css("background-color", getSetting("progress1Color"));
                    break;
                case "clarity":

                    $(".goalContainerOverlay").attr("src",'/img/widgets/goals/clarity.png').css("filter", filters);
                    $(".progressBar").css("background-color", getSetting("progress2Color"));
                    $(".progressBarProgress").css("background-color", getSetting("progress1Color"));
                    break;
                //legacy designs
                case "default":
                default:
                    $(".background").css("background-color", getSetting("backgroundColor")).css("filter", "unset");
                    $(".progressBar").css("background-color", getSetting("progress2Color")).css("filter", "unset");
                    $(".progressBarProgress").css("background-color", getSetting("progress1Color")).css("filter", "unset");
                    $(".progressBarProgress").css("filter", "unset");
                    break;
            }

            if (isOwn3dDesign){
                $(".progressBarTitleSuffix").text("");

                switch (layout){
                    case "simple":
                        $(".own3d").removeClass("layout-standard layout-condensed").addClass("layout-simple");

                        $(".layout-simple .progressBarTitleSuffix").text(`: ${(lastValue)} / ${lastGoalValue.toLocaleString()} (${Math.floor(currentProgressbarValue)}%)`);
                        break;
                    case "condensed":
                        $(".own3d").removeClass("layout-standard layout-simple").addClass("layout-condensed");
                        break;
                    case "standard":
                    default:
                        $(".own3d").removeClass("layout-simple layout-condensed").addClass("layout-standard");
                        break;
                }
            }

            $(".font").css("color", getSetting("fontColor"));
            $(".progressBarProgressPercent").css("color", getSetting("percentageColor"));

            if (getSetting("showTitle") === false) {
                $(".textContainer").hide(200);
            } else {
                $(".textContainer").show(200);
            }

            if (window.TextEffectsIntegration) {
                TextEffectsIntegration.applyTitleEffects('goal' + goalMetric, '.progressBarTitleMain', settings);
                TextEffectsIntegration.applyTitleEffects('goal' + goalMetric, '.goalText', settings);
            }

            if (getSetting("enableParallelogram") === false || variation !== "default") {
                $(".goalContainer").css("transform", "skew(0deg)");
                $(".font,.progressBarProgressPercent").css("transform", "skew(0deg)");
            } else {
                $(".goalContainer").css("transform", "skew(-15deg)");
                $(".font,.progressBarProgressPercent").css("transform", "skew(15deg)");
            }
        }

        function updateGoal(goalStatus) {
            if (loadingTimeout) {
                clearTimeout(loadingTimeout);
                loadingTimeout = null;
            }

            if (testing) return;

            function getConfigValue(key) {
                return goalStatus.config["goal_" + goalMetric + "_" + key];
            }

            function getStatusValue(key) {
                return goalStatus.status[goalMetric][key];
            }

            var text = getConfigValue("title") !== "" ? (getConfigValue("title") + " - ") : "";
            $(".progressBarTitleMain").text(getConfigValue("title"))

            if (getConfigValue("value") !== lastGoalValue && lastGoalValue > 0) {
                $('.widget').addClass('flip');
                setTimeout(() => {
                    $('.widget').removeClass('flip');

                    setTimeout(() => $(".font").css("color", getSetting("progress2Color")), 500);
                    setTimeout(() => $(".font").css("color", getSetting("fontColor")), 1000);
                    setTimeout(() => $(".font").css("color", getSetting("progress2Color")), 1500);
                    setTimeout(() => $(".font").css("color", getSetting("fontColor")), 2000);
                    setTimeout(() => $(".font").css("color", getSetting("progress2Color")), 2500);
                    setTimeout(() => $(".font").css("color", getSetting("fontColor")), 3000);
                }, 1100)
            }

            let fullHit = getStatusValue("percentage") && getStatusValue("percentage") !== lastPercentValue && lastPercentValue < 100 && getStatusValue("percentage") >= 100;
            let bigHit = getStatusValue("percentage") && getStatusValue("percentage") > (lastPercentValue + 40);

            if (fullHit || bigHit) {
                $('.widget').addClass('shake');
                setTimeout(() => {
                    $('.widget').removeClass('shake');
                }, 1600)
            }

            lastGoalValue = getConfigValue("value");
            lastPercentValue = getStatusValue("percentage");

            switch (goalMetric) {
                case "subs":
                    text += "{val} / " + getConfigValue("value").toLocaleString() + " Subs";
                    break;
                case "chestlikes":
                    text += "{val} / " + getConfigValue("value").toLocaleString() + " Chest Likes";
                    break;
                case "viewer":
                    text += "{val} / " + getConfigValue("value").toLocaleString() + " Viewers";
                    break;
                case "custom1":
                case "custom2":
                case "custom3":
                    text += "{val} / " + getConfigValue("value").toLocaleString();
                    break;
                default:
                    text += "{val} / " + getConfigValue("value").toLocaleString() + " " + goalMetric.charAt(0).toUpperCase() + goalMetric.slice(1)
            }
            
            $(".progressBarProgressGoal").text(getConfigValue("value").toLocaleString());

            updateGoalValueWithAnimation(text, getStatusValue("current"))
            // $(".goalText").text(text);

            setProgressBarValue(getStatusValue("percentage"));
            

            if (getConfigValue('increaseSelect') === "3" && getStatusValue("percentage") >= 100) {
                hideTimeout = setTimeout(() => {
                    $('.widget').slideUp(500);
                }, 10000);
            } else {
                if (hideTimeout) {
                    clearTimeout(hideTimeout);
                    hideTimeout = null;
                }
                $('.widget').slideDown(500);
            }

            if (!channelId && !init) testGoal(null);
            init = true;
        }

        let lastValueSet = null;

        function setProgressBarValue(newValue) {
            if (newValue === lastValueSet) {
                return;
            }

            lastValueSet = newValue;

            newValue = Math.floor(newValue);

            if (progressBarUpdateInterval) clearInterval(progressBarUpdateInterval);
            var increaseValue = newValue - currentProgressbarValue;
            if (increaseValue === 0) return;

            var stepValue = increaseValue / 50;

            progressBarUpdateInterval = setInterval(() => {

                currentProgressbarValue += stepValue;

                if (stepValue > 0 && currentProgressbarValue >= newValue) {
                    clearInterval(progressBarUpdateInterval);
                    currentProgressbarValue = newValue;
                }

                if (stepValue < 0 && currentProgressbarValue <= newValue) {
                    clearInterval(progressBarUpdateInterval);
                    currentProgressbarValue = newValue;
                }

                var rounded = Math.floor(currentProgressbarValue);
                var barWidth = currentProgressbarValue;

                if (barWidth < 1) barWidth = 0;
                if (barWidth > 100) barWidth = 100;

                $(".layout-simple .progressBarTitleSuffix").text(`: ${(lastValue)} / ${lastGoalValue.toLocaleString()} (${rounded}%)`);
                $(".progressBarProgressCurrentProgress").text((lastValue).toLocaleString());
                $(".progressBarProgressPercent").text(rounded + "%");
                $(".progressBarProgress").css("width", barWidth + "%");

            }, 30)
        }

        function testGoal(data) {
            if ((data !== null && data.metric !== goalMetric) || testing) return;
            testing = true;

            var valueBefore = currentProgressbarValue;

            currentProgressbarValue = 0;
            setProgressBarValue(100);

            setTimeout(() => {
                setProgressBarValue(valueBefore);

                setTimeout(() => {
                    testing = false;
                }, 3000)
            }, 2000)
        }

        let lastValue = 0;
        let lastFunctionCallId = 0;

        async function updateGoalValueWithAnimation(template, value) {
            function updateGoalValue(template) {
                $(".goalText").text(template.replace("{val}", lastValue.toLocaleString()));
                $(".progressBarProgressCurrentProgress").text(lastValue.toLocaleString());
            }

            let thisFunctionCallId = Date.now() + "_" + Math.random();
            lastFunctionCallId = thisFunctionCallId;

            if (value > lastValue) {

                let step = Math.ceil((value - lastValue) / 25)

                while (lastValue < value) {
                    if (thisFunctionCallId !== lastFunctionCallId) {
                        break;
                    }

                    lastValue += step;
                    if (lastValue > value) lastValue = value;
                    updateGoalValue(template, lastValue);
                    await new Promise(resolve => setTimeout(resolve, 50));
                }

            } else {
                lastValue = value;
                updateGoalValue(template, value);
            }
        }


        $(window).on("load", () => {
            io.on("goalStatus", updateGoal);
            io.on("testGoal", testGoal);
            updateSettings();
        });
    </script>
</head>

<body>

<div class="widget legacy">
    <div class="goalContainer">
        <div class="background progressContainer">
            <div class="progressBar">
                <div class="progressBarProgress"></div>
                <div class="progressBarProgressPercent">0%</div>

            </div>
        </div>
        <div class="background textContainer">
            <div class="font goalText">Connecting...</div>
        </div>
    </div>
</div>

<div class="widget own3d hidden">

    <div class="progressBarTitle font">
        <span class="progressBarTitleMain">Goal</span>
        <span class="progressBarTitleSuffix"></span>
    </div>
    <div class="goalContainer">
        <img class="goalContainerOverlay"/>
        <div class="progressBar">
            <div class="progressBarProgress"></div>
        </div>
        <div class="progressBarTextContainer">

            <div class="progressBarProgressCurrentProgress font">0</div>
            <div class="progressBarProgressGoal font">10</div>
        </div>
    </div>
</div>

<script defer src="https://static.cloudflareinsights.com/beacon.min.js/v8c78df7c7c0f484497ecbca7046644da1771523124516" integrity="sha512-8DS7rgIrAmghBFwoOTujcf6D9rXvH8xm8JQ1Ja01h9QX8EzXldiszufYa4IFfKdLUKTTrnSFXLDkUEOTrZQ8Qg==" data-cf-beacon='{"version":"2024.11.0","token":"65f9075973884fc192143938ea377297","server_timing":{"name":{"cfCacheStatus":true,"cfEdge":true,"cfExtPri":true,"cfL4":true,"cfOrigin":true,"cfSpeedBrain":true},"location_startswith":null}}' crossorigin="anonymous"></script>
</body>

</html>