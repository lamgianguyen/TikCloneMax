    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/js/guard/obf/trc.js"></script>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.1/socket.io.min.js" crossorigin="anonymous"></script>

    <script src="sharedio/sharedio.js"></script>
    <script src="socketioclient.js?v=10"></script>

    <style>
        iframe {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
            z-index: 999999;
        }
    </style>
</head>

<body>
    <iframe src="./vite/src/heart-fountain/index.html"></iframe>

    <script>
        io.on("onLikeReceived", (payload) => {
            if (!payload.isTest && !settings.isPro && !location.href.includes('preview=1')) {
                return;
            }
            document.querySelector("iframe").contentWindow.postMessage({ type: "onLikeReceived", payload }, "*");
        });

        setInterval(() => {
            if (typeof settings !== undefined) {
                document.querySelector("iframe").contentWindow.postMessage({
                    type: "onSettings",
                    settings: {
                        randomColor: settings.likefountain_randomColor,
                        heartColor1: settings.likefountain_heartColor1,
                        heartColor2: settings.likefountain_heartColor2,
                        showProfilePictures: settings.likefountain_showProfilePictures,
                        randomPosition: settings.likefountain_randomPosition !== false,
                    }
                }, "*");
            }
        }, 100)

        let previewIndex = 0;
        let previewEnabled = true;

        function preview() {
            if (!previewEnabled) return;
            previewIndex += 1;

            if (previewIndex === 3) {
                io.fakeEmit('onLikeReceived', {
                    likeCount: 15,
                    profilePictureUrl: "https://p16-useast2a.tiktokcdn.com/tos-useast2a-avt-0068-giso/4ec174248f94de26938f73874962469b~c5_100x100.jpeg",
                    userId: Math.random().toString(36).substring(7),
                    isTest: true
                });
            }

            if (previewIndex === 6) {
                previewIndex = 0;
            }
        }
    </script>

<script defer src="https://static.cloudflareinsights.com/beacon.min.js/v8c78df7c7c0f484497ecbca7046644da1771523124516" integrity="sha512-8DS7rgIrAmghBFwoOTujcf6D9rXvH8xm8JQ1Ja01h9QX8EzXldiszufYa4IFfKdLUKTTrnSFXLDkUEOTrZQ8Qg==" data-cf-beacon='{"version":"2024.11.0","token":"65f9075973884fc192143938ea377297","server_timing":{"name":{"cfCacheStatus":true,"cfEdge":true,"cfExtPri":true,"cfL4":true,"cfOrigin":true,"cfSpeedBrain":true},"location_startswith":null}}' crossorigin="anonymous"></script>
</body>

</html>