    <iframe src="./eventcarousel/index.html" onload="setConfig()"></iframe>

    <script>
        let previewEnabled = true;

        function updateSettings(hasChanged) {
            previewEnabled = !settings.config?.events?.length;
            document.querySelector("iframe").contentWindow.postMessage({ type: "config", configData: settings.config }, "*");
        }

        function setConfig() {
            setTimeout(() => {
                if (settings.config) {
                    previewEnabled = !settings.config?.events?.length;
                    document.querySelector("iframe").contentWindow.postMessage({ type: "config", configData: settings.config }, "*");
                }
            }, 500)
        }


        function preview() {
