  }

</script>
<!-- [/TIKFINITY BROWSER STUB] -->

    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/js/guard/obf/trc.js"></script>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.1/socket.io.min.js" crossorigin="anonymous"></script>

    <script src="sharedio/sharedio.js"></script>
    <script src="socketioclient.js?v=10"></script>

    <title>Gift Cannon Widget</title>

    <style>
        /* Full-screen transparent canvas for physics */
        #overlayCanvas {
            position: fixed;
            top: -1px;
            left: -1px;
            width: calc(100% + 2px);
            height: calc(100% + 2px);
            pointer-events: none;
            z-index: 999;
            background: transparent;
        }

        /* Container for cannon */
        #cannonContainer {
            position: fixed;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
            z-index: 1000;
        }

        /* Cannon image responsive size */
        #cannon {
            width: 10vw;
            max-width: 100px;
            height: auto;
            display: block;
        }
    </style>
</head>

<body>
    <canvas id="overlayCanvas"></canvas>
    <div id="cannonContainer">
        <img id="cannon" src="img/cannon.png" alt="Cannon">
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
    <script>
        // Matter.js modules
        const { Engine, Render, Runner, Bodies, Composite, Body, Events } = Matter;

        // Configuration variables
        window.ballTimeout = 30;
        window.maxBalls = 20;
        window.ballSize = 50;
        window.intensity = 50;
        window.showGiftPictures = true;
        window.showCannon = true;

        // Create engine and world
        const engine = Engine.create();
        const world = engine.world;
        world.gravity.y = 1;

        // Setup renderer
        const canvas = document.getElementById('overlayCanvas');
        const render = Render.create({
            canvas, engine,
            options: {
                width: window.innerWidth,
                height: window.innerHeight,
                wireframes: false,
                background: 'transparent'
            }
        });
        Render.run(render);
        Runner.run(Runner.create(), engine);

        // World bounds
        let thickness;
        const bounds = [];
        function createBounds() {
            Composite.remove(world, bounds);
            bounds.length = 0;
            thickness = Math.max(50, Math.min(window.innerWidth, window.innerHeight) * 0.1);
            bounds.push(
                Bodies.rectangle(window.innerWidth / 2, -thickness / 2, window.innerWidth, thickness, { isStatic: true }),
                Bodies.rectangle(window.innerWidth / 2, window.innerHeight + thickness / 2, window.innerWidth, thickness, { isStatic: true }),
                Bodies.rectangle(-thickness / 2, window.innerHeight / 2, thickness, window.innerHeight, { isStatic: true }),
                Bodies.rectangle(window.innerWidth + thickness / 2, window.innerHeight / 2, thickness, window.innerHeight, { isStatic: true })
            );
            Composite.add(world, bounds);
        }
        createBounds();

        // Rotate cannon between -45° and +45° smoothly and position it
        const cannonContainer = document.getElementById('cannonContainer');
        const cannonImg = document.getElementById('cannon');

        setInterval(() => {
            cannonContainer.style.opacity = window.showCannon ? 0.8 : 0;
        }, 250);

        function updateCannonPosition() {
            const rect = cannonImg.getBoundingClientRect();
            const cannonHeight = rect.height;
            // Position cannon so half of it is below the screen
            cannonContainer.style.bottom = `-${cannonHeight / 2}px`;
        }

        function rotateCannon() {
            const period = 10000; // 10s full cycle
            const t = performance.now();
            const angle = Math.sin((t / period) * 2 * Math.PI) * (Math.PI / 4);
            cannonContainer.style.transform = `translateX(-50%) rotate(${angle}rad)`;
            requestAnimationFrame(rotateCannon);
        }

        // Initialize cannon position after image loads
        cannonImg.onload = () => {
            updateCannonPosition();
            rotateCannon();
        };
        // Fallback in case image is already loaded
        if (cannonImg.complete) {
            updateCannonPosition();
            rotateCannon();
        }

        // Helper to create circular texture with mirrored gift image
        function createTexture(giftPictureUrl, profilePictureUrl, size) {
            return new Promise(resolve => {
                const off = document.createElement('canvas');
                off.width = off.height = size;
                const ctx = off.getContext('2d');
                ctx.beginPath();
                ctx.arc(size / 2, size / 2, size / 2, 0, 2 * Math.PI);
                ctx.clip();

                const imgProf = new Image();
                imgProf.crossOrigin = 'anonymous';
                imgProf.src = profilePictureUrl;

                if (window.showGiftPictures === false) {
                    // Only profile image if giftPictureUrl is null
                    imgProf.onload = () => {
                        ctx.drawImage(imgProf, 0, 0, size, size);
                        resolve(off.toDataURL());
                    };
                } else {
                    // Both images, with gift image mirrored
                    const imgGift = new Image();
                    imgGift.crossOrigin = 'anonymous';
                    imgGift.src = giftPictureUrl;
                    let loaded = 0;
                    function check() {
                        if (++loaded === 2) {
                            ctx.drawImage(imgProf, 0, 0, size, size); // Unflipped profile image
                            ctx.save();
                            ctx.scale(-1, 1); // Mirror gift image horizontally
                            ctx.drawImage(imgGift, -size, 0, size, size); // Adjust x for flip
                            ctx.restore();
                            resolve(off.toDataURL());
                        }
                    }
                    imgProf.onload = check;
                    imgGift.onload = check;
                }
            });
        }


        // Track active projectiles
        const activeProjectiles = [];

        // Helper to remove a projectile with shrinking animation
        function removeProjectile(projectile, useAnimation = true, reason = 'unknown') {
            if (!activeProjectiles.includes(projectile)) return; // Already removed

            console.log(`Removing projectile: reason=${reason}, y=${projectile.position.y}, activeCount=${activeProjectiles.length}`);
            const index = activeProjectiles.indexOf(projectile);
            if (index !== -1) activeProjectiles.splice(index, 1);

            if (!useAnimation) {
                // Immediate removal without animation
                Composite.remove(world, projectile);
                return;
            }

            // Shrinking animation
            let scale = 1;
            const shrinkDuration = 1000; // 1 second shrink animation
            const startTime = performance.now();

            const shrink = () => {
                const elapsed = performance.now() - startTime;
                scale = Math.max(0, 1 - elapsed / shrinkDuration); // Linearly reduce scale to 0
                projectile.render.sprite.xScale = scale;
                projectile.render.sprite.yScale = scale;

                if (scale <= 0) {
                    Composite.remove(world, projectile);
                } else {
                    requestAnimationFrame(shrink);
                }
            };
            requestAnimationFrame(shrink);
        }

        /**
         * Fire a gift cannon shot with correct muzzle positioning.
         */
        async function sendCannon(giftPictureUrl, profilePictureUrl) {
            // Check for overcrowding: remove oldest projectile if resting balls span 80%+ of screen height
            let restingBalls = 0;
            let minY = Infinity;
            let maxY = -Infinity;
            let nonRestingInfo = [];
            for (const projectile of activeProjectiles) {
                const velocity = Math.hypot(projectile.velocity.x, projectile.velocity.y);
                if (velocity < 1.0) { // Increased threshold for resting
                    restingBalls++;
                    minY = Math.min(minY, projectile.position.y);
                    maxY = Math.max(maxY, projectile.position.y);
                } else {
                    nonRestingInfo.push(`y=${projectile.position.y}, vel=${velocity}`);
                }
            }
            const span = maxY - minY;
            const isOvercrowded = (
                (restingBalls >= 5 && span >= 0.8 * window.innerHeight) || // Normal overcrowding: 5+ resting, 80% span
                (restingBalls >= 3 && span >= 0.95 * window.innerHeight) || // Full screen: 3+ resting, 95% span
                (activeProjectiles.length >= 20 && span >= 0.9 * window.innerHeight) // Extreme congestion: 20+ total, 90% span
            );
            if (isOvercrowded) {
                console.log(`Overcrowding triggered: ${restingBalls} resting balls, total=${activeProjectiles.length}, span=${span}, threshold=${0.8 * window.innerHeight}, minY=${minY}, maxY=${maxY}`);
                const oldestProjectile = activeProjectiles[0];
                removeProjectile(oldestProjectile, false, 'overcrowding');
            } else if (restingBalls > 0 || activeProjectiles.length >= 10) {
                console.log(`Overcrowding check failed: ${restingBalls} resting balls, total=${activeProjectiles.length}, span=${span}, threshold=${0.8 * window.innerHeight}, minY=${minY}, maxY=${maxY}`);
                if (nonRestingInfo.length > 0) {
                    console.log(`Non-resting projectiles: ${nonRestingInfo.join('; ')}`);
                }
            }

            // Enforce maxBalls limit by removing oldest projectiles immediately
            while (activeProjectiles.length >= window.maxBalls) {
                const oldestProjectile = activeProjectiles[0];
                removeProjectile(oldestProjectile, false, 'maxBalls');
            }

            // Calculate projectile size and speed based on window size
            const minDimension = Math.min(window.innerWidth, window.innerHeight);
            const referenceSize = 1080; // Reference resolution for scaling
            const speedScale = 0.7 + 0.3 * (minDimension / referenceSize); // Moderate speed reduction
            const radiusFactor = 0.03 + 0.02 * Math.sqrt(referenceSize / minDimension); // Moderate increase at small sizes
            const baseRadius = Math.min(50, Math.max(16, minDimension * radiusFactor)); // Base radius
            // Apply window.ballSize (0 to 100, 50 is default)
            const clampedBallSize = Math.min(100, Math.max(0, window.ballSize || 50)); // Clamp to [0, 100], default to 50
            const sizeMultiplier = clampedBallSize / 50; // 0 → 0, 50 → 1, 100 → 2
            const projRadius = Math.min(100, Math.max(16, baseRadius * sizeMultiplier)); // Adjusted radius, capped at 100px
            const textureSize = Math.round(projRadius * 2);
            const texture = await createTexture(giftPictureUrl, profilePictureUrl, textureSize);

            // Compute current angle and muzzle position
            const t = performance.now();
            const angle = Math.sin((t / 10000) * 2 * Math.PI) * (Math.PI / 4);
            const rect = cannonImg.getBoundingClientRect();
            const length = rect.height - 50; // Full image height as barrel length
            const pivotX = rect.left + rect.width / 2;
            const pivotY = rect.bottom - length * 0.4; // Pivot 40% up the barrel
            const muzzleX = pivotX + Math.sin(angle) * length;
            const muzzleY = pivotY - Math.cos(angle) * length;

            // Create projectile
            const projectile = Bodies.circle(muzzleX, muzzleY - 20, projRadius, {
                restitution: 0.9,
                friction: 0.1,
                render: { sprite: { texture, xScale: 1, yScale: 1 } }
            });
            Composite.add(world, projectile);
            activeProjectiles.push(projectile);

            // Calculate speed for target height, ensuring proportional power
            const frac = 0.6 + Math.random() * 0.3; // Target 60-90% of screen height
            const peakY = window.innerHeight * (1 - frac);
            const h = muzzleY - peakY;
            const vy = Math.sqrt(2 * world.gravity.y * h); // Vertical velocity to reach peakY
            let speed = vy / Math.abs(Math.cos(angle)); // Total speed based on angle
            speed *= speedScale; // Apply moderate speed reduction for small screens
            // Apply window.intensity (1 to 100, 50 is default)
            const clampedIntensity = Math.min(100, Math.max(1, window.intensity || 50)); // Clamp to [1, 100], default to 50
            const intensityMultiplier = clampedIntensity / 50; // 1 → 0.02, 50 → 1, 100 → 2
            speed *= intensityMultiplier; // Adjust speed based on intensity
            Body.setVelocity(projectile, { x: Math.sin(angle) * speed, y: -Math.cos(angle) * speed });

            // Set timeout to remove projectile after window.ballTimeout
            setTimeout(() => {
                removeProjectile(projectile, true, 'ballTimeout');
            }, window.ballTimeout * 1000);
        }
        window.sendCannon = sendCannon;

        // Handle resize
        window.addEventListener('resize', () => {
            render.canvas.width = window.innerWidth;
            render.canvas.height = window.innerHeight;
            render.options.width = window.innerWidth;
            render.options.height = window.innerHeight;
            createBounds();
            updateCannonPosition();
        });
    </script>

    <script>
        $(window).on("load", () => {
            let giftStreaks = {};

            async function handleOnGift(giftData) {
                if (!giftData.isTest && !settings.isPro && !location.href.includes('preview=1')) {
                    return;
                }

                if (giftData.giftType > 1 || giftData.isTest) {
                    console.log("CREATE CANNON GIFT", giftData);
                    sendCannon(giftData.giftPictureUrl, giftData.profilePictureUrl);
                    return;
                }

                let giftKey = `${giftData.userId}_${giftData.giftId}`;

                if (!giftStreaks[giftKey] || giftStreaks[giftKey] > giftData.repeatCount) {
                    giftStreaks[giftKey] = 0;
                }

                let difference = giftData.repeatCount - giftStreaks[giftKey];

                if (difference > 0) {
                    giftStreaks[giftKey] = giftData.repeatCount;
                    while (difference > 0) {
                        difference--;
                        await new Promise(resolve => setTimeout(resolve, 200));
                        sendCannon(giftData.giftPictureUrl, giftData.profilePictureUrl);
                    }
                }

                if (giftData.repeatEnd) {
                    delete giftStreaks[giftKey];
                }
            }

            io.on("gift", handleOnGift);
            io.on("giftCanonTest", handleOnGift);
        });

        function updateSettings() {
            window.ballTimeout = settings?.cannon_ballTimeout || 30;
            window.maxBalls = settings?.cannon_maxBalls || 20;
            window.ballSize = settings?.cannon_ballSize || 50;
            window.intensity = settings?.cannon_intensity || 50;
            window.showGiftPictures = settings?.cannon_showGiftPictures !== false;
            window.showCannon = settings?.cannon_showCannon !== false;
        }

        updateSettings();

        let previewIndex = 0;
        let previewEnabled = true;

        function preview() {
            if (!previewEnabled) return;
            previewIndex += 1;

            if (previewIndex === 1) {
                io.fakeEmit("gift", {
                    profilePictureUrl: "https://p16-useast2a.tiktokcdn.com/tos-useast2a-avt-0068-giso/4ec174248f94de26938f73874962469b~c5_1080x1080.jpeg",
                    giftPictureUrl: 'https://p19-webcast.tiktokcdn.com/img/maliva/webcast-va/eba3a9bb85c33e017f3648eaf88d7189~tplv-obj.png',
                    isTest: true
                })
            }

            if (previewIndex === 5) {
                io.fakeEmit("gift", {
                    profilePictureUrl: "https://p16-useast2a.tiktokcdn.com/tos-useast2a-avt-0068-euttp/5d4e5d9ac5b98e0ba2a3758a05ed0bd7~c5_100x100.webp",
                    giftPictureUrl: 'https://p16-webcast.tiktokcdn.com/img/maliva/webcast-va/485175fda92f4d2f862e915cbcf8f5c4~tplv-obj.webp',
                    isTest: true
                })
            }

            if (previewIndex === 7) {
                io.fakeEmit("gift", {
                    profilePictureUrl: "https://p16-useast2a.tiktokcdn.com/tos-useast2a-avt-0068-euttp/9cc62a1d3245baf539406ad3f42beee1~tplv-tiktok-shrink:72:72.webp",
                    giftPictureUrl: 'https://p16-webcast.tiktokcdn.com/img/maliva/webcast-va/eba3a9bb85c33e017f3648eaf88d7189~tplv-obj.webp',
                    isTest: true
                })
            }

            if (previewIndex === 9) {
                io.fakeEmit("gift", {
                    profilePictureUrl: "https://p16-pu-no.tiktokcdn-eu.com/tos-no1a-avt-0068c001-no/f636efa4998a9ad0facd60d1b5683cec~tplv-tiktokx-cropcenter:100:100.webp",
                    giftPictureUrl: 'https://p16-webcast.tiktokcdn.com/img/maliva/webcast-va/eba3a9bb85c33e017f3648eaf88d7189~tplv-obj.webp',
                    isTest: true
                })
            }

            if (previewIndex === 11) {
                io.fakeEmit("gift", {
                    profilePictureUrl: "https://p16-pu-no.tiktokcdn-eu.com/tos-no1a-avt-0068c001-no/f636efa4998a9ad0facd60d1b5683cec~tplv-tiktokx-cropcenter:100:100.webp",
                    giftPictureUrl: 'https://p16-webcast.tiktokcdn.com/img/maliva/webcast-va/eba3a9bb85c33e017f3648eaf88d7189~tplv-obj.webp',
                    isTest: true
                })
            }

            if (previewIndex === 14) {
                io.fakeEmit("gift", {
                    profilePictureUrl: "https://p16-pu-no.tiktokcdn-eu.com/tos-no1a-avt-0068c001-no/f636efa4998a9ad0facd60d1b5683cec~tplv-tiktokx-cropcenter:100:100.webp",
                    giftPictureUrl: 'https://p16-webcast.tiktokcdn.com/img/maliva/webcast-va/eba3a9bb85c33e017f3648eaf88d7189~tplv-obj.webp',
                    isTest: true
                })
            }

            if (previewIndex === 17) {
                io.fakeEmit("gift", {
                    profilePictureUrl: "https://p16-pu-no.tiktokcdn-eu.com/tos-no1a-avt-0068c001-no/f636efa4998a9ad0facd60d1b5683cec~tplv-tiktokx-cropcenter:100:100.webp",
                    giftPictureUrl: 'https://p16-webcast.tiktokcdn.com/img/maliva/webcast-va/3f02fa9594bd1495ff4e8aa5ae265eef~tplv-obj.webp',
                    isTest: true
                })
            }

            if (previewIndex === 20) {
                io.fakeEmit("gift", {
                    profilePictureUrl: "https://p16-pu-no.tiktokcdn-eu.com/tos-no1a-avt-0068c001-no/f636efa4998a9ad0facd60d1b5683cec~tplv-tiktokx-cropcenter:100:100.webp",
                    giftPictureUrl: 'https://p16-webcast.tiktokcdn.com/img/maliva/webcast-va/802a21ae29f9fae5abe3693de9f874bd~tplv-obj.webp',
                    isTest: true
                })
            }

            if (previewIndex === 25) {
                previewIndex = 0;
            }
        }
    </script>
