const { spawn } = require('child_process');
const path = require('path');
const fs = require('fs');

const exe = path.join(__dirname, 'node_modules', 'electron', 'dist', 'electron.exe');

const env = { ...process.env };
delete env.ELECTRON_RUN_AS_NODE;
delete env.ELECTRON_NO_ATTACH_CONSOLE;

const logPath = process.env.TIKMAX_LAUNCHER_LOG || path.join(require('os').tmpdir(), 'tikmax-electron.log');
const out = fs.openSync(logPath, 'a');
const err = fs.openSync(logPath, 'a');

const child = spawn(exe, ['.'], {
    cwd: __dirname,
    detached: true,
    stdio: ['ignore', out, err],
    windowsHide: false,
    env
});
child.unref();
console.log(`[launcher] electron PID=${child.pid} log=${logPath}`);
